@model TechXpress_domain.Entities.Category

@{
    ViewData["Title"] = "Category Details: " + Model.Name;
}
@section styles {
    <style>
        /* Category Details Container */
        .category-details {
            max-width: 1100px;
            margin: 3rem auto;
            padding: 0 1rem;
            text-align: left;
        }
        .category-details h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            color: var(--primary);
            border-bottom: 2px solid var(--secondary);
            padding-bottom: 0.5rem;
        }
        .category-details p {
            font-size: 1.25rem;
            margin-bottom: 2.5rem;
            line-height: 1.8;
            color: var(--dark);
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
        }

        /* Product Card */
        .product-card {
            background: linear-gradient(135deg, #ffffff, #f4f4f4);
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        }

        /* Product Image */
        .product-image {
            width: 100%; 
            height: 200px; 
            object-fit: fill; 
            border-bottom: 2px solid var(--secondary); 
        }
        /* Product Content */
        .product-content {
            padding: 1rem;
        }
        .product-title {
            font-size: 1.4rem;
            font-weight: bold;
            margin: 0.5rem 0;
            color: var(--dark);
        }
        .product-price {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--primary);
        }

        /* Responsive adjustments */
        @@media (min-width: 768px) {
            .category-details {
                text-align: center;
            }
            .product-title,
            .product-price {
                text-align: center;
            }
        }
    </style>
}

<div class="category-details">
    <h1>@Model.Name</h1>
    <p>@Model.Description</p>

    @if (Model.Products != null && Model.Products.Any())
    {
        <h2>Products in @Model.Name</h2>
        <div class="products-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="product-link">
                        <img src="@product.ImageUrl" alt="@product.Name" class="product-image" />
                        <h3 class="product-title">@product.Name</h3>
                    </a>
                    <p class="product-price">@product.Price.ToString("C")</p>
                </div>
            }
        </div>
    }
    else
    {
        <p>No products available in this category.</p>
    }
</div>
