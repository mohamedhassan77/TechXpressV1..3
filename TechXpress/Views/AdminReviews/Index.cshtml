@model IEnumerable<TechXpress.Models.ReviewViewModel>
@{
    ViewData["Title"] = "Review Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Review Management</h2>
<div class="reviews-grid row">
    @foreach (var review in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card review-card">
                <div class="card-header text-center">
                    <div class="avatar bg-info text-white rounded-circle" style="width: 60px; height:60px;">
                        @(string.IsNullOrEmpty(review.UserName) ? "?" : review.UserName.Substring(0, 1))
                    </div>
                    <div class="mt-2">
                        <strong>@(string.IsNullOrEmpty(review.UserName) ? "Unknown" : review.UserName)</strong>
                    </div>
                </div>
                <div class="card-body">
                    <p><strong>Product:</strong> @(string.IsNullOrEmpty(review.ProductName) ? "N/A" : review.ProductName)</p>
                    <p>
                        <strong>Rating:</strong>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="@(i <= review.Rating ? "fas fa-star text-warning" : "far fa-star text-muted")"></i>
                        }
                    </p>
                    <p><strong>Comment:</strong> @review.Comment</p>
                    <p><small>Reviewed on @review.CreatedAt.ToString("MMM dd, yyyy")</small></p>
                </div>
                <div class="card-footer text-center">
                    <a href="@Url.Action("Details", "AdminReviews", new { id = review.Id })" class="btn btn-sm btn-primary me-1">View Details</a>
                    <a href="@Url.Action("Edit", "AdminReviews", new { id = review.Id })" class="btn btn-sm btn-warning me-1">Edit</a>
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@review.Id" />
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .review-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

            .review-card .card-header {
                background-color: #f8f9fa;
            }

        .avatar {
            font-size: 1.5rem;
            line-height: 1;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
}
