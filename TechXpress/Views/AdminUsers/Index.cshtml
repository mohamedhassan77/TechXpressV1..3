@model IEnumerable<TechXpress.Models.UserProfileViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>User Management</h2>
<div class="users-grid row">
    @foreach (var user in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card user-card">
                <div class="card-header text-center">
                    <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl) ? "/images/default-avatar.png" : user.ProfilePictureUrl)" alt="Profile Image" class="img-fluid rounded-circle" style="width: 80px; height:80px;" />
                    <div class="mt-2">
                        <span class="badge @(user.IsBlocked ? "bg-danger" : "bg-success")">
                            @(user.IsBlocked ? "Blocked" : "Active")
                        </span>
                    </div>
                </div>
                <div class="card-body text-center">
                    <h5>@user.FirstName @user.LastName</h5>
                    <p>@user.Email</p>
                    <p>Joined: @user.CreatedAt.ToString("MMM dd, yyyy")</p>
                </div>
                <div class="card-footer text-center">
                    <a href="@Url.Action("Details", "AdminUsers", new { id = user.UserId })" class="btn btn-sm btn-primary">View</a>
                    <a href="@Url.Action("Edit", "AdminUsers", new { id = user.UserId })" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="DeleteUser" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@user.UserId" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .user-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

            .user-card .card-header {
                background-color: #f8f9fa;
            }
    </style>
}
