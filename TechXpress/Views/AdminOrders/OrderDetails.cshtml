@model TechXpress.Models.OrderDetailsViewModel

@{
    if (Model == null)
    {
        <p>Error: Order details are not available.</p>
        return;
    }
    ViewData["Title"] = $"Order #{Model.OrderId}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}

<div class="order-details-container">
    <div class="details-header d-flex justify-content-between align-items-start mb-4">
        <div class="header-left">
            <h1>Order Details</h1>
            <p class="order-number">Order #@Model.OrderId</p>
            <p class="order-date">Placed on @Model.OrderDate.ToString("MMMM dd, yyyy")</p>
        </div>
        <div class="order-status @Model.CurrentStatus.ToLower()">
            <span class="status-label">@Model.CurrentStatus</span>
            @if (Model.CurrentStatus == "Shipped" && !string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <div class="tracking-info mt-2">
                    <p>Tracking Number: @Model.TrackingNumber</p>
                    <a href="https://trackingservice.com/@Model.TrackingNumber" target="_blank" class="btn btn-sm btn-outline-primary">
                        Track Package <i class="fas fa-external-link-alt ms-1"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="admin-actions p-3 bg-white rounded shadow-sm mb-4">
        <h2>Admin Actions</h2>
        <div class="d-flex flex-wrap gap-3 align-items-center">
            <form asp-controller="AdminOrders" asp-action="UpdateStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.OrderId" />
                @Html.AntiForgeryToken()
                <div class="d-flex align-items-center">
                    <select name="newStatus" class="form-select d-inline w-auto">
                        <option value="Pending" @@(Model.CurrentStatus == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Processing" @@(Model.CurrentStatus == "Processing" ? "selected" : "")>Processing</option>
                        <option value="Shipped" @@(Model.CurrentStatus == "Shipped" ? "selected" : "")>Shipped</option>
                        <option value="Delivered" @@(Model.CurrentStatus == "Delivered" ? "selected" : "")>Delivered</option>
                        <option value="Cancelled" @@(Model.CurrentStatus == "Cancelled" ? "selected" : "")>Cancelled</option>
                    </select>
                    <button type="submit" class="btn btn-primary ms-2">
                        <i class="fas fa-save me-1"></i> Update Status
                    </button>
                </div>
            </form>
            
            <form asp-controller="AdminOrders" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this order?');">
                <input type="hidden" name="id" value="@Model.OrderId" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt me-1"></i> Delete Order
                </button>
            </form>
        </div>
    </div>

    <div class="details-grid row g-4">
        <div class="order-summary col-lg-8">
            <div class="summary-section p-3 bg-white rounded shadow-sm mb-3">
                <h2>Items (@(Model.Items?.Count ?? 0))</h2>
                <div class="items-list">
                    @if (Model.Items != null)
                    {
                        foreach (var item in Model.Items)
                        {
                            <div class="order-item d-flex align-items-center border-bottom py-2">
                                <img src="@(item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl ?? item.Product?.ImageUrl ?? "/images/placeholder.png")" alt="@(item.Product?.Name ?? "Unknown Product")" class="me-3" style="width: 100px; height: 100px; object-fit: cover; border-radius: 5px;" />
                                <div class="item-details">
                                    <h3 class="h5 mb-1">@(item.Product?.Name ?? "Unknown Product")</h3>
                                    <p class="item-sku text-muted mb-1">SKU: @(item.Product?.SKU ?? "N/A")</p>
                                    <div class="item-price-qty d-flex gap-3 mb-1">
                                        <span class="item-price text-primary fw-bold">@item.PriceAtPurchase.ToString("C")</span>
                                        <span class="item-quantity text-muted">Qty: @item.Quantity</span>
                                    </div>
                                    <p class="item-total fw-bold text-success">Total: @((item.Quantity * item.PriceAtPurchase).ToString("C"))</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="summary-section p-3 bg-white rounded shadow-sm">
                <h2>Order Summary</h2>
                <div class="price-breakdown">
                    <div class="price-row d-flex justify-content-between">
                        <span>Subtotal</span>
                        <span>@Model.Subtotal.ToString("C")</span>
                    </div>
                    <div class="price-row d-flex justify-content-between">
                        <span>Shipping</span>
                        <span>@Model.ShippingCost.ToString("C")</span>
                    </div>
                    @if (Model.Discount > 0)
                    {
                        <div class="price-row d-flex justify-content-between discount">
                            <span>Discount</span>
                            <span>-@Model.Discount.ToString("C")</span>
                        </div>
                    }
                    <div class="price-row d-flex justify-content-between tax">
                        <span>Tax</span>
                        <span>@Model.Tax.ToString("C")</span>
                    </div>
                    <div class="price-row d-flex justify-content-between total border-top pt-3 mt-2 fw-bold">
                        <span>Total</span>
                        <span>@Model.Total.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="order-info col-lg-4">
            <div class="info-section p-3 bg-white rounded shadow-sm mb-3">
                <h2>Shipping Address</h2>
                <div class="address-details">
                    @if (Model.ShippingAddress != null)
                    {
                        <p class="name fw-bold">@Model.ShippingAddress.FullName</p>
                        <p>@Model.ShippingAddress.Street</p>
                        <p>@Model.ShippingAddress.City, @Model.ShippingAddress.State @Model.ShippingAddress.PostalCode</p>
                        <p>@Model.ShippingAddress.Country</p>
                    }
                    else
                    {
                        <p>No shipping address provided.</p>
                    }
                </div>
            </div>

            <div class="info-section p-3 bg-white rounded shadow-sm mb-3">
                <h2>Billing Address</h2>
                <div class="address-details">
                    @if (Model.BillingAddress != null)
                    {
                        <p class="name fw-bold">@Model.BillingAddress.FullName</p>
                        <p>@Model.BillingAddress.Street</p>
                        <p>@Model.BillingAddress.City, @Model.BillingAddress.State @Model.BillingAddress.PostalCode</p>
                        <p>@Model.BillingAddress.Country</p>
                    }
                    else
                    {
                        <p>No billing address provided.</p>
                    }
                </div>
            </div>

            <div class="info-section p-3 bg-white rounded shadow-sm">
                <h2>Payment Information</h2>
                <div class="payment-details">
                    <p>Payment Method: @Model.PaymentMethod</p>
                    <p>Payment Details: @Model.PaymentDetails</p>
                </div>
            </div>
        </div>
    </div>

    <div class="details-actions mt-4 d-flex gap-3">
        <a asp-controller="AdminOrders" asp-action="Index" class="btn btn-back">
            <i class="fas fa-arrow-left me-1"></i> Back to Orders
        </a>
        <a href="javascript:window.print()" class="btn btn-print">
            <i class="fas fa-print me-1"></i> Print Order
        </a>
    </div>
</div>

@section Styles {
    <style>
        .order-details-container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .details-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }

        .order-number {
            font-size: 1.2rem;
            color: #666;
            margin: 5px 0;
        }

        .order-date {
            color: #666;
        }

        .order-status {
            padding: 10px 20px;
            border-radius: 5px;
            text-align: center;
        }

            .order-status.pending {
                background: #fff3cd;
                color: #856404;
            }

            .order-status.processing {
                background: #cce5ff;
                color: #004085;
            }

            .order-status.shipped {
                background: #d4edda;
                color: #155724;
            }

            .order-status.delivered {
                background: #d1e7dd;
                color: #0f5132;
            }

            .order-status.cancelled {
                background: #f8d7da;
                color: #721c24;
            }

        .tracking-info {
            margin-top: 10px;
            font-size: 0.9rem;
        }

        .admin-actions {
            background-color: #f8f9fa;
            border-left: 4px solid #0d6efd;
        }

        .btn-back,
        .btn-print {
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-back {
            background: #f8f9fa;
            color: #333;
            border: 1px solid #ddd;
        }

        .btn-print {
            background: #6c757d;
            color: white;
            border: none;
        }

        @@media (max-width: 992px) {
            .details-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 768px) {
            .details-header {
                flex-direction: column;
                gap: 15px;
            }

            .details-actions {
                flex-direction: column;
            }

            .btn-back,
            .btn-print {
                width: 100%;
                justify-content: center;
            }

            .admin-actions .d-flex {
                flex-direction: column;
                align-items: flex-start;
            }

            .admin-actions form {
                margin-bottom: 10px;
                width: 100%;
            }

            .admin-actions .form-select {
                width: 100% !important;
                margin-bottom: 10px;
            }

            .admin-actions button {
                width: 100%;
            }
        }

        @@media print {
            .details-actions,
            .admin-actions {
                display: none;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Fade in animation for the order details container
            const orderDetailsContainer = document.querySelector(".order-details-container");
            if (orderDetailsContainer) {
                orderDetailsContainer.style.opacity = 0;
                orderDetailsContainer.style.transition = "opacity 0.8s ease-out";
                setTimeout(() => {
                    orderDetailsContainer.style.opacity = 1;
                }, 100);
            }

            // Auto-select current status in the dropdown
            const statusSelect = document.querySelector('select[name="newStatus"]');
            if (statusSelect) {
                statusSelect.value = "@Model.CurrentStatus";
            }
        });
    </script>
}