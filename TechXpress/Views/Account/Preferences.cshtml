@model TechXpress.Models.UserSettingsViewModel

<div class="preferences-container">
    <div class="preferences-header">
        <h2>User Preferences</h2>
    </div>

    <form asp-action="Preferences" method="post" class="preferences-content">
        <div class="preferences-section">
            <h3 class="preferences-section-title">Notification Settings</h3>
            <div class="preference-group">
                <div class="preference-item">
                    <label asp-for="EmailNotifications">Email Notifications</label>
                    <label class="toggle-switch">
                        <input asp-for="EmailNotifications" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="preference-item">
                    <label asp-for="SmsNotificationsEnabled">SMS Notifications</label>
                    <label class="toggle-switch">
                        <input asp-for="SmsNotificationsEnabled" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="preference-item">
                    <label asp-for="MarketingEmails">Marketing Emails</label>
                    <label class="toggle-switch">
                        <input asp-for="MarketingEmails" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="preferences-section">
            <h3 class="preferences-section-title">Privacy Controls</h3>
            <div class="preference-group">
                <div class="preference-item">
                    <label asp-for="ShowBirthDate">Show Birth Date</label>
                    <label class="toggle-switch">
                        <input asp-for="ShowBirthDate" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="preference-item">
                    <label asp-for="ProfileVisibility">Profile Visibility</label>
                    <label class="toggle-switch">
                        <input asp-for="ProfileVisibility" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <div class="preferences-section">
            <h3 class="preferences-section-title">Regional Settings</h3>
            <div class="preference-group">
                <div class="preference-item">
                    <label asp-for="LanguagePreference">Language</label>
                    <select asp-for="LanguagePreference" class="select-input">
                        <option value="en">English</option>
                        <option value="es">Spanish</option>
                        <option value="fr">French</option>
                    </select>
                </div>
                <div class="preference-item">
                    <label asp-for="PreferredCurrency">Currency</label>
                    <select asp-for="PreferredCurrency" class="select-input">
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="preferences-section">
            <h3 class="preferences-section-title">Display Preferences</h3>
            <div class="preference-group">
                <div class="preference-item">
                    <label asp-for="Theme">Theme</label>
                    <select asp-for="Theme" class="select-input">
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="preferences-section">
            <h3 class="preferences-section-title">Security</h3>
            <div class="preference-group">
                <div class="preference-item">
                    <label asp-for="TwoFactorEnabled">Two-Factor Authentication</label>
                    <label class="toggle-switch">
                        <input asp-for="TwoFactorEnabled" type="checkbox" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <input type="hidden" asp-for="UserId" />
        <button type="submit" class="save-button">Save Preferences</button>
    </form>
</div>

@section Styles {
    <style>
        :root {
            --primary-color: #FF3366;
            --secondary-color: #6C63FF;
            --background-light: #f4f7f6;
            --text-dark: #2d3748;
            --border-color: #e2e8f0;
            --input-background: #f9fafb;
        }

        body {
            font-family: 'Arial', sans-serif;
            background-color: var(--background-light);
            line-height: 1.6;
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 1rem;
        }

        .preferences-container {
            width: 100%;
            max-width: 800px;
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .preferences-header {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem;
            text-align: center;
        }

            .preferences-header h2 {
                font-size: 1.8rem;
                font-weight: 700;
            }

        .preferences-content {
            padding: 2rem;
        }

        .preferences-section {
            margin-bottom: 2rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1.5rem;
        }

            .preferences-section:last-child {
                border-bottom: none;
            }

        .preferences-section-title {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--primary-color);
        }

        .preference-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .preference-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--input-background);
            padding: 1rem;
            border-radius: 10px;
            transition: background-color 0.3s ease;
        }

            .preference-item:hover {
                background-color: #f1f3f5;
            }

            .preference-item label {
                margin-right: 1rem;
            }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

            .toggle-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 34px;
        }

            .toggle-slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 3px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }

        .toggle-switch input:checked + .toggle-slider {
            background-color: var(--primary-color);
        }

            .toggle-switch input:checked + .toggle-slider:before {
                transform: translateX(24px);
            }

        .select-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background-color: white;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

            .select-input:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(255, 51, 102, 0.1);
            }

        .save-button {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.3s ease;
            margin-top: 1rem;
        }

            .save-button:hover {
                opacity: 0.9;
            }

        @@media (max-width: 600px) {
            .preference-group

        {
            grid-template-columns: 1fr;
        }

        .preferences-container {
            margin: 0;
            border-radius: 0;
            min-height: 100vh;
        }

        }
    </style>
}