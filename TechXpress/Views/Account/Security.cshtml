@model TechXpress.Models.SecuritySettingsViewModel

@{
    ViewData["Title"] = "Security Settings";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <form asp-action="Security" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter current password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" class="form-control" type="password" placeholder="Enter new password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-reset">Update Security Settings</button>
        </form>

        <h3 class="mt-4">Login History</h3>
        <ul class="list-unstyled">
            @foreach (var entry in Model.LoginHistory)
            {
                <li>@entry.DateTime.ToString("g"): @entry.Location - @entry.DeviceType</li>
            }
        </ul>

        <h3 class="mt-4">Active Sessions</h3>
        <ul class="list-unstyled">
            @foreach (var session in Model.ActiveSessions)
            {
                <li>@session.DeviceType - @session.Location (@session.LastActive.ToString("g"))</li>
            }
        </ul>
    </div>
</div>
