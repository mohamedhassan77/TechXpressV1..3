@model TechXpress.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="profile-page">
    <div class="profile-header">
        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="profile-avatar" />
        <div class="profile-info">
            <h1>@Model.FirstName @Model.LastName</h1>
            <p>@Model.Email</p>
            <p>@Model.PhoneNumber</p>
        </div>
    </div>

    <div class="profile-section">
        <h2 class="section-title">About Me</h2>
        <p><strong>Date of Birth:</strong> @(Model.DateOfBirth?.ToString("MM/dd/yyyy") ?? "N/A")</p>
        <p><strong>Joined:</strong> @Model.CreatedAt.ToString("MM/dd/yyyy")</p>
        <p><strong>Gender:</strong> @Model.Gender</p>
    </div>

    <!-- Navigation Buttons -->
    <div class="profile-nav-buttons">
        <a asp-action="Manage" asp-controller="Account" class="nav-button">Edit Profile</a>
        <a asp-action="index" asp-controller="Cart" class="nav-button">Cart</a>
        <a asp-action="Security" asp-controller="Account" class="nav-button">Security</a>
        <a asp-action="Settings" asp-controller="Account" class="nav-button">Settings</a>
    </div>
</div>

@section Styles {
    <style>
        /* Overall Container */
        .profile-page {
            max-width: 900px;
            margin: 2rem auto;
            padding: 2rem;
            background: linear-gradient(135deg, #ffffff, #f9f9fb);
            border-radius: 16px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
            animation: fadeIn 0.8s ease-out;
        }
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Profile Header */
        .profile-header {
            display: flex;
            align-items: center;
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #e0e0e0;
        }

        .profile-avatar {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 1.5rem;
            border: 4px solid transparent;
            background: linear-gradient(45deg, #ff3366, #6c63ff);
            padding: 3px;
        }

        .profile-info h1 {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 0.5rem;
        }

        .profile-info p {
            font-size: 1.1rem;
            color: #555;
            margin: 0.3rem 0;
        }

        /* Profile Section */
        .profile-section {
            padding: 1rem 0;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: #2d3748;
            position: relative;
        }

            .section-title::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: -5px;
                width: 60px;
                height: 3px;
                background: var(--primary, #ff3366);
                border-radius: 3px;
            }

        .profile-section p {
            font-size: 1.1rem;
            color: #666;
            margin: 0.5rem 0;
        }

        /* Navigation Buttons */
        .profile-nav-buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            margin-top: 2rem;
        }

        .nav-button {
            flex: 1 1 180px;
            text-align: center;
            padding: 0.75rem 1.5rem;
            background: var(--primary, #ff3366);
            color: #fff;
            border-radius: 8px;
            text-decoration: none;
            transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
        }

            .nav-button:hover {
                background: var(--secondary, #6c63ff);
                transform: translateY(-3px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            }

        /* Responsive Adjustments */
       @@media (max-width: 768px) {
            .profile-header

        {
            flex-direction: column;
            text-align: center;
        }

        .profile-avatar {
            margin-right: 0;
            margin-bottom: 1rem;
        }

        .profile-info h1 {
            font-size: 2rem;
        }

        .profile-info p {
            font-size: 1rem;
        }

        .profile-page {
            margin: 1rem;
            padding: 1.5rem;
        }

        }
    </style>
}
