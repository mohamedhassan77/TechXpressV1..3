@using TechXpress.Models;
@model UserProfileViewModel

@{
    ViewData["Title"] = "Profile";
}


<div class="profile-container">
    <!-- Header       -->
    <header class="profile-header">
        <div class="cover-image" style="background-image: url('@(Model.ProfilePictureUrl ?? "https://www.pngarts.com/files/10/Default-Profile-Picture-Download-PNG-Image.png")');"></div>
        <!-- Cart Link with Icon Badge -->
        <div class="header-actions">
            <a asp-action="Index" asp-controller="Cart" class="cart-button">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-label">Cart</span>
            </a>
        </div>
        <div class="profile-details">
            <div class="profile-avatar">
                <img src="@Model.ProfilePictureUrl" alt="Profile Picture" />
                <div class="avatar-status online"></div>
            </div>
            <div class="basic-info">
                <h1>@Model.FirstName @Model.LastName</h1>
                <div class="user-contact">
                   <span><i class="fas fa-phone"></i> @Model.PhoneNumber</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Body Section with     Navigation -->
    <div class="profile-body">
        <nav class="profile-nav">
            <ul>
                <li class="active" data-tab="about">
                    <i class="fas fa-user"></i>
                    <span>About Me</span>
                </li>
                <li data-tab="activity">
                    <i class="fas fa-chart-line"></i>
                    <span>My Activity</span>
                </li>
                <li data-tab="settings">
                    <i class="fas fa-cog"></i>
                    <span>Settings</span>
                </li>
            </ul>
        </nav>

        <section class="tab-content">
            <!-- About Me Tab -->
            <div class="tab-panel active" id="about">
                <h2><i class="fas fa-info-circle"></i> About Me</h2>
                <div class="info-card">
                    <div class="info-item">
                        <span class="info-label"><i class="fas fa-birthday-cake"></i> Date of Birth</span>
                        <span class="info-value">@(Model.DateOfBirth?.ToString("MM/dd/yyyy") ?? "N/A")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label"><i class="fas fa-calendar-check"></i> Joined</span>
                        <span class="info-value">@Model.CreatedAt.ToString("MM/dd/yyyy")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label"><i class="fas fa-venus-mars"></i> Gender</span>
                        <span class="info-value">@Model.Gender</span>
                    </div>
                </div>
            </div>

            <!-- My Activity Tab: Orders, Addresses, Cart -->
            <div class="tab-panel" id="activity">
                <h2><i class="fas fa-chart-line"></i> My Activity</h2>

                <div class="activity-grid">

                    <!-- Orders Section -->
                    <div class="activity-column">
                        <div class="column-header">
                            <i class="fas fa-shopping-bag"></i>
                            <a asp-controller="Order" asp-action="Index" class="cta-button">
                                <h3 class="mb-0">Orders</h3>
                                <i class="bi bi-arrow-right fs-4"></i>
                            </a>
                        </div>

                        @if (Model.Orders.Any())
                        {
                            <ul class="activity-list list-unstyled m-0 p-0">
                                @foreach (var order in Model.Orders.Take(3))
                                {
                                    <li class="activity-item p-3 border-bottom hover-bg">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="activity-title d-block fw-bold text-dark">Order #@order.Id</span>
                                                <div class="d-flex align-items-center">
                                                    <span class="activity-date me-2 text-muted">
                                                        <i class="far fa-calendar-alt me-1"></i> @order.OrderDate.ToShortDateString()
                                                    </span>
                                                    <span class="badge @GetStatusBadgeClass(order.Status.ToString())">@order.Status</span>
                                                </div>
                                            </div>
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                               class="activity-action btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="fas fa-eye me-1"></i> Details
                                            </a>
                                        </div>
                                    </li>
                                }
                            </ul>

                            @if (Model.Orders.Count() > 3)
                            {
                                <div class="text-center py-3 border-top">
                                    <a asp-controller="Order" asp-action="Index" class="text-decoration-none text-primary fw-medium">
                                        <i class="fas fa-plus-circle me-1"></i> See @(Model.Orders.Count() - 3) more orders
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-box-open"></i>
                                <p>No orders found</p>
                                <a asp-controller="product" asp-action="Index" class="text-decoration-none text-primary fw-medium">
                                    <class ="cta-button">Shop Now
                                </a>
                              
                            </div>
                        }
                    </div>

                    <!-- Addresses Section -->
                    <div class="activity-column">
                        <div class="column-header">
                            <i class="fas fa-map-marker-alt"></i>
                            <h3>Addresses</h3>
                        </div>

                        @if (Model.Addresses.Any())
                        {
                            <ul class="activity-list list-unstyled">
                                @foreach (var address in Model.Addresses)
                                {
                                    <li class="activity-item p-3 border-bottom hover-bg">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="activity-title d-block fw-bold text-dark">@address.Street</span>
                                                <span class="activity-subtitle text-muted">@address.City, @address.Country</span>
                                            </div>
                                            <a asp-action="EditAddress" asp-controller="UserProfile"
                                               class="activity-action btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </a>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-home"></i>
                                <p>No addresses found</p>
                            </div>
                        }

                        <!-- Add Address Button (always visible) -->
                        <div class="text-center py-3">
                            <a asp-action="AddAddress" asp-controller="UserProfile" class="cta-button">
                                <i class="fas fa-plus-circle me-1"></i> Add Address
                            </a>
                        </div>
                    </div>

                    <!-- Cart Section -->
                    <div class="activity-column">
                        <div class="column-header">
                            <i class="fas fa-shopping-cart"></i>
                            <h3>Cart</h3>
                        </div>

                        <div class="cart-preview text-center p-3">
                            <div class="cart-icon">
                                <i class="fas fa-shopping-cart fa-2x"></i>
                            </div>
                            <p class="mt-2">Review your items and checkout</p>
                            <a asp-action="Index" asp-controller="Cart" class="cta-button pulse">
                                <i class="fas fa-arrow-right"></i> View Cart
                            </a>
                        </div>
                    </div>

                </div> 

            </div> 

            <!-- Settings Tab with Modern Button Designs -->
            <div class="tab-panel" id="settings">
                <h2><i class="fas fa-cog"></i> Settings</h2>
                <div class="settings-actions">
                    <a asp-action="Manage" asp-controller="Account" class="settings-button primary-button">
                        <i class="fas fa-user-edit"></i>
                        <span>Edit Profile</span>
                    </a>
                    <a asp-action="Security" asp-controller="Account" class="settings-button secondary-button">
                        <i class="fas fa-shield-alt"></i>
                        <span>Security</span>
                    </a>
                    <a asp-action="Preferences" asp-controller="Account" class="settings-button secondary-button">
                        <i class="fas fa-sliders-h"></i>
                        <span>Preferences</span>
                    </a>
                </div>
            </div>
        </section>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        /* Base Variables */
        :root {
          
        
            /* Global Settings */
            --transition-speed: 0.3s;
            --border-radius: 4px;
            --primary-color: #FF3366; /* Coral */
            --primary-dark: #f8f9fa; /* Tomato */
            --primary-light: #F8F9FA; /* Light Salmon */
            --secondary-color: #F8F9FA;
            --accent-color: #4cc9f0;
            --blue-gradient-start: #4cc9f0;
            --blue-gradient-end: #00bfff;
            --text-dark: #333333;
            --text-medium: #333333;
            --text-light: #333333;
            --background-light: #f8f9fa;
            --background-white: #ffffff;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-md: 0 4px 12px rgba(0,0,0,0.12);
            --shadow-lg: 0 8px 24px rgba(0,0,0,0.15);
            --radius-sm: 6px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition-fast: 0.2s ease;
            --transition-normal: 0.3s ease;
            --font-primary: 'Poppins', sans-serif;
        }

        /* Base Container */
        body {
            background-color: #f0f2f5;
            color: var(--text-dark);
            font-family: var(--font-primary);
        }

        .profile-container {
            max-width: 1100px;
            margin: 2.5rem auto;
            background: var(--background-white);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            position: relative;
        }

        /* Profile Header */
        .profile-header {
            position: relative;
            height: 280px;
        }

        .cover-image {
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            position: relative;
        }

            .cover-image::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.6));
            }

        /* Header Actions */
        .header-actions {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 10;
        }

        .cart-button {
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.3);
            color: white;
            padding: 0.6rem 1.2rem;
            border-radius: var(--radius-lg);
            text-decoration: none;
            transition: background var(--transition-normal), transform var(--transition-normal);
            box-shadow: var(--shadow-sm);
        }

            .cart-button:hover {
                background: rgba(255,255,255,0.35);
                transform: translateY(-2px);
            }

            .cart-button i {
                margin-right: 8px;
                font-size: 1.1rem;
            }

        /* Profile Details */
        .profile-details {
            position: absolute;
            bottom: -55px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(12px);
            padding: 1.5rem 2.5rem;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            width: 85%;
            z-index: 5;
        }

        .profile-avatar {
            position: relative;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            margin-right: 1.5rem;
            border: 4px solid var(--primary-color);
            box-shadow: var(--shadow-md);
        }

            .profile-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform var(--transition-normal);
            }

            .profile-avatar:hover img {
                transform: scale(1.05);
            }

        .avatar-status {
            position: absolute;
            bottom: 8px;
            right: 8px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 3px solid white;
        }

            .avatar-status.online {
                background-color: #4ade80;
            }

        .basic-info {
            flex: 1;
        }

            .basic-info h1 {
                font-size: 2.2rem;
                font-weight: 600;
                margin: 0 0 10px 0;
                color: var(--primary-color);
                letter-spacing: -0.5px;
            }

        .user-contact {
            display: flex;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

            .user-contact span {
                display: flex;
                align-items: center;
                color: var(--text-medium);
                font-size: 0.95rem;
            }

            .user-contact i {
                color: var(--primary-color);
                margin-right: 8px;
            }

        /* Profile Body & Navigation */
        .profile-body {
            margin-top: 70px;
            padding: 1.5rem 2.5rem 3rem;
        }

        .profile-nav {
            margin-bottom: 2rem;
            border-bottom: 1px solid rgba(0,0,0,0.08);
            position: relative;
        }

            .profile-nav::after {
                content: '';
                position: absolute;
                bottom: -1px;
                height: 1px;
                width: 100%;
                background: linear-gradient(90deg, rgba(67,97,238,0) 0%, rgba(67,97,238,0.2) 25%, rgba(67,97,238,0.2) 75%, rgba(67,97,238,0) 100%);
            }

            .profile-nav ul {
                list-style: none;
                display: flex;
                padding: 0;
                margin: 0;
                gap: 0.5rem;
            }

                .profile-nav ul li {
                    padding: 0.8rem 1.5rem;
                    cursor: pointer;
                    color: var(--text-medium);
                    transition: all var(--transition-normal);
                    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    font-weight: 500;
                    position: relative;
                }

                    .profile-nav ul li i {
                        color: var(--primary-color);
                        opacity: 0.7;
                        transition: opacity var(--transition-normal);
                    }

                    .profile-nav ul li::after {
                        content: '';
                        position: absolute;
                        bottom: -1px;
                        left: 0;
                        width: 100%;
                        height: 3px;
                        background: var(--primary-color);
                        transform: scaleX(0);
                        transition: transform var(--transition-normal);
                        z-index: 1;
                    }

                    .profile-nav ul li.active::after,
                    .profile-nav ul li:hover::after {
                        transform: scaleX(1);
                    }

                    .profile-nav ul li.active {
                        color: var(--primary-color);
                        background-color: rgba(67,97,238,0.05);
                    }

                        .profile-nav ul li.active i,
                        .profile-nav ul li:hover i {
                            opacity: 1;
                        }

                    .profile-nav ul li:hover {
                        color: var(--secondary-dark);
                    }

        /* Tab Content */
        .tab-content {
            padding: 1.5rem 0;
        }

        .tab-panel {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

            .tab-panel.active {
                display: block;
            }

            .tab-panel h2 {
                margin-top: 0;
                margin-bottom: 1.5rem;
                color: var(--text-dark);
                font-weight: 600;
                position: relative;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .tab-panel h2 i {
                    color: var(--primary-color);
                }

        /* Info Card */
        .info-card {
            background: var(--background-light);
            border-radius: var(--radius-md);
            padding: 1.5rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            box-shadow: var(--shadow-sm);
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .info-label {
            color: var(--text-light);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .info-label i {
                color: var(--primary-color);
            }

        .info-value {
            color: var(--text-dark);
            font-weight: 500;
            font-size: 1.1rem;
        }

        /* Activity Grid */
        .activity-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .activity-column {
            background: var(--background-light);
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform var(--transition-normal), box-shadow var(--transition-normal);
            height: 100%;
        }

            .activity-column:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .column-header {
            background: var(--primary-color);
            color: white;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .column-header h3 {
                margin: 0;
                font-weight: 500;
            }

        .activity-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .activity-item {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
            gap: 5px;
            position: relative;
        }

            .activity-item:last-child {
                border-bottom: none;
            }

        .activity-title {
            font-weight: 500;
            color: var(--text-dark);
        }

        .activity-subtitle, .activity-date {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .activity-action {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--primary-color);
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            opacity: 0;
            transition: opacity var(--transition-normal);
        }

        .activity-item:hover .activity-action {
            opacity: 1;
        }

        /* Empty State */
        .empty-state {
            padding: 2rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.8rem;
        }

            .empty-state i {
                font-size: 2.5rem;
                color: var(--text-light);
                opacity: 0.6;
            }

            .empty-state p {
                color: var(--text-medium);
                margin: 0;
            }

        /* Cart Preview */
        .cart-preview {
            padding: 2rem;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .cart-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(67,97,238,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .cart-icon i {
                font-size: 2rem;
                color: var(--primary-color);
            }

        /* CTA Button */
        .cta-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: var(--radius-md);
            padding: 0.8rem 1.5rem;
            font-weight: 500;
            text-decoration: none;
            transition: background var(--transition-normal), transform var(--transition-normal), box-shadow var(--transition-normal);
            margin-top: 0.5rem;
        }

            .cta-button:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
            }

            .cta-button.pulse {
                animation: pulse 2s infinite;
            }

        /* Settings Buttons */
        .settings-actions {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .settings-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 1.2rem 1.5rem;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-weight: 500;
            transition: background var(--transition-normal), transform var(--transition-normal), box-shadow var(--transition-normal);
            box-shadow: var(--shadow-sm);
        }

            .settings-button i {
                font-size: 1.2rem;
            }

            .settings-button:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .primary-button,
        .edit-button {
            background: linear-gradient(135deg, var(--primary-dark));
            color: white;
            border: 2px solid var(--primary-color);
        }

            .primary-button:hover,
            .edit-button:hover {
                background: linear-gradient(135deg,  var(--primary-color));
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .secondary-button {
            background: white;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
        }

            .secondary-button:hover {
                  transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .tertiary-button,
        .preference-button {
            background: linear-gradient(135deg, var(--blue-gradient-start), var(--blue-gradient-end));
            color: white;
            border: none;
        }

            .tertiary-button:hover,
            .preference-button:hover {
                background: linear-gradient(135deg, var(--blue-gradient-end), var(--blue-gradient-start));
                transform: translateY(-4px);
                box-shadow: var(--shadow-md);
            }

        .settings-button.primary-button {
            background-color: white;
            color:blue;
            border: none;
            padding: 1.2rem 1.5rem;
            border-radius: var(--radius-md);
            text-decoration: none;
            font-weight: 500;
            transition: background var(--transition-normal), transform var(--transition-normal), box-shadow var(--transition-normal);
            box-shadow: var(--shadow-sm);
        }

          
        /* Animations */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes pulse {
            0%

        {
            box-shadow: 0 0 0 0 rgba(67,97,238,0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(67,97,238,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(67,97,238,0);
        }

        }

        /* Responsive Adjustments */
        @@media (max-width: 992px) {
            .profile-details

        {
            width: 95%;
            padding: 1.2rem 1.5rem;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
        }

        .basic-info h1 {
            font-size: 1.8rem;
        }

        }

        @@media (max-width: 768px) {
            .profile-container

        {
            margin: 1rem;
        }

        .profile-details {
            flex-direction: column;
            text-align: center;
            padding: 1.5rem 1rem;
            bottom: -80px;
        }

        .profile-avatar {
            margin-right: 0;
            margin-bottom: 1rem;
            width: 100px;
            height: 100px;
        }

        .user-contact {
            justify-content: center;
        }

        .profile-body {
            margin-top: 95px;
            padding: 1rem 1.2rem 2rem;
        }

        .profile-nav ul {
            flex-direction: row;
            overflow-x: auto;
            padding-bottom: 5px;
        }

            .profile-nav ul li {
                white-space: nowrap;
            }

        .info-card {
            grid-template-columns: 1fr;
        }

        }

        @@media (max-width: 480px) {
            .activity-grid

        {
            grid-template-columns: 1fr;
        }

        .settings-actions {
            grid-template-columns: 1fr;
        }

        .user-contact {
