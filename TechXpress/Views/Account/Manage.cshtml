@model TechXpress.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Manage Profile";
}

<div class="profile-page">
    <div class="profile-header">
        <img src="@Model.ProfilePictureUrl" alt="Profile Picture" class="profile-avatar" />
        <div class="profile-info">
            <h1>@Model.FirstName @Model.LastName</h1>
            <p>@Model.Email</p>
            <p>@Model.PhoneNumber</p>
        </div>
    </div>

    <div class="profile-nav">
        <ul class="profile-nav-list">
            <li class="profile-nav-item">
                <a href="@Url.Action("Profile", "Account")" class="profile-nav-link @( (ViewContext.RouteData.Values["action"]?.ToString() == "Profile") ? "active" : "" )">
                    Profile
                </a>
            </li>
            <li class="profile-nav-item">
                <a href="@Url.Action("Settings", "Account")" class="profile-nav-link @( (ViewContext.RouteData.Values["action"]?.ToString() == "Settings") ? "active" : "" )">
                    Settings
                </a>
            </li>
            <li class="profile-nav-item">
                <a href="@Url.Action("Security", "Account")" class="profile-nav-link @( (ViewContext.RouteData.Values["action"]?.ToString() == "Security") ? "active" : "" )">
                    Security
                </a>
            </li>
            <li class="profile-nav-item">
                <a href="@Url.Action("Wishlist", "Account")" class="profile-nav-link @( (ViewContext.RouteData.Values["action"]?.ToString() == "Wishlist") ? "active" : "" )">
                    Wishlist
                </a>
            </li>
        </ul>
    </div>

    <div class="profile-section">
        <h2 class="section-title">Manage Your Profile</h2>
        <p>Update your personal details and settings.</p>
    </div>
</div>
