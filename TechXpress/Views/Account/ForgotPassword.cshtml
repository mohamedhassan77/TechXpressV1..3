@model TechXpress.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <p class="auth-subtitle text-center">Enter your email to reset your password</p>

        @if (TempData["Success"] != null && (bool)TempData["Success"])
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                Password reset instructions have been sent to your email.
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-reset">Send Reset Link</button>
                <div class="auth-footer text-center mt-3">
                    <a asp-action="Login" class="back-to-login">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Styles {
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #f8f9fa;
        }

        .auth-card {
            background: #fff;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

            .auth-card h2 {
                margin-bottom: 10px;
                color: #333;
            }

        .auth-subtitle {
            color: #666;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            color: #555;
        }

        .form-control {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }

        .btn-reset {
            width: 100%;
            padding: 12px;
            background: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-bottom: 20px;
        }

            .btn-reset:hover {
                background: #0056b3;
            }

        .back-to-login {
            color: #666;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .back-to-login:hover {
                color: #007bff;
            }

        .alert {
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert i {
            font-size: 1.2rem;
        }
    </style>
}
