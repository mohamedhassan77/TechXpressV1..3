@model TechXpress.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <p class="auth-subtitle text-center">Enter your email to reset your password</p>

        @if (TempData["Success"] != null && (bool)TempData["Success"])
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                Password reset instructions have been sent to your email.
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-reset">Send Reset Link</button>
                <div class="auth-footer text-center mt-3">
                    <a asp-action="Login" class="back-to-login">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Styles {
    <style>
        body {
            background: url('~/IMG/CoP.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem;
            position: relative;
        }

        .auth-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.95));
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            padding: 3.5rem 3rem;
            max-width: 480px;
            width: 100%;
            position: relative;
            animation: float 6s ease-in-out infinite;
        }

        @@keyframes float {
            0%

        {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        100% {
            transform: translateY(0px);
        }

        }

        .auth-card h2 {
            margin-bottom: 1rem;
            font-size: 2.75rem;
            font-weight: 600;
            background: linear-gradient(45deg, #2c3e50, #3498db);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align: center;
        }

        .auth-subtitle {
            color: #34495e;
            font-size: 1.1rem;
            text-align: center;
            margin-bottom: 2.5rem;
            opacity: 0.8;
        }

        .form-group {
            margin-bottom: 2rem;
            position: relative;
        }

        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            font-weight: 500;
            color: #2c3e50;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control {
            width: 100%;
            padding: 1rem 1.25rem;
            background: rgba(255, 255, 255, 0.8);
            border: 2px solid rgba(44, 62, 80, 0.1);
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.95);
                border-color: #3498db;
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.2);
                transform: translateY(-2px);
            }

            .form-control::placeholder {
                color: #95a5a6;
            }

        /* Validation styles */
        div[asp-validation-summary="ModelOnly"] {
            display: none;
        }

            div[asp-validation-summary="ModelOnly"].validation-summary-errors {
                display: block;
                background: rgba(231, 76, 60, 0.1);
                border-left: 4px solid #e74c3c;
                border-radius: 8px;
                padding: 1rem;
                margin-bottom: 2rem;
                animation: fadeIn 0.3s ease;
            }

        span[asp-validation-for] {
            display: none;
        }

            span[asp-validation-for].field-validation-error {
                display: block;
                color: #e74c3c;
                font-size: 0.875rem;
                margin-top: 0.5rem;
                animation: fadeIn 0.3s ease;
            }

        /* Alert styles */
        .alert {
            padding: 1.25rem;
            border-radius: 12px;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            animation: fadeIn 0.3s ease;
        }

        .alert-success {
            background: linear-gradient(135deg, rgba(46, 213, 115, 0.1), rgba(46, 213, 115, 0.2));
            border: 1px solid rgba(46, 213, 115, 0.3);
            color: #2ed573;
        }

        .alert i {
            font-size: 1.5rem;
        }

        .btn-reset {
            width: 100%;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(45deg, #3498db, #2980b9);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        }

            .btn-reset:hover {
                background: linear-gradient(45deg, #2980b9, #2c3e50);
                transform: translateY(-3px);
                box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
            }

            .btn-reset:active {
                transform: translateY(-1px);
            }

        .auth-footer {
            margin-top: 2rem;
            text-align: center;
        }

        .back-to-login {
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .back-to-login:hover {
                color: #2980b9;
                background: rgba(52, 152, 219, 0.1);
                transform: translateX(-5px);
            }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@media (max-width: 640px) {
            .auth-card

        {
            padding: 2.5rem 1.5rem;
            margin: 1rem;
        }

        .auth-card h2 {
            font-size: 2.25rem;
        }

        .auth-subtitle {
            font-size: 1rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        }
    </style>
}
