@model TechXpress.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn-reset">Login</button>
        </form>
        <div class="auth-footer text-center mt-3">
            <a asp-action="ForgotPassword" class="back-to-login">Forgot your password?</a>
            <span> | </span>
            <a asp-action="Register" class="back-to-login">Register as a new user</a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Reuse container/card styles from ForgotPassword */
    </style>
}
