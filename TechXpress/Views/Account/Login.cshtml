@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout"; // Ensure consistent layout
}

@section Styles {
    <style>
        :root {
            --primary: #FF3366;
            --secondary: #6C63FF;
            --dark: #1E1E2F;
            --light: #F8F9FA;
            --accent: #00F5A0;
            --text: #333333;
        }

        .login-container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 3rem;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 400px;
            margin: 2rem auto;
            position: relative;
            z-index: 1;
        }

        .login-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 2rem;
            background: linear-gradient(to right, var(--primary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align: center;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            padding: 1rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: white;
                box-shadow: 0 0 0 3px rgba(var(--primary-rgb), 0.1);
            }

        .nav-button {
            background: var(--primary);
            color: white;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            width: 100%;
        }

            .nav-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(var(--primary-rgb), 0.3);
            }

        .extra-links a {
            color: rgba(255, 255, 255, 0.8);
            transition: color 0.3s ease;
        }

            .extra-links a:hover {
                color: var(--accent);
            }

        .validation-summary {
            color: #ff4d4d;
            background: rgba(255, 255, 255, 0.9);
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }
    </style>
}

<div class="login-container">
    <h1 class="login-title">Welcome Back</h1>

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <form asp-action="Login" method="post">
        <div class="form-group mb-4">
            <label asp-for="Email" class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" placeholder="hello@techxpress.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="password-input-group">
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <button type="button" class="password-toggle" aria-label="Show password">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember Me</label>
            </div>
        </div>

        <button type="submit" class="nav-button mb-4">Sign In</button>

        <div class="extra-links d-flex flex-column gap-2">
            <a asp-action="Register" asp-controller="Account">Create new account</a>
            <a asp-action="ForgotPassword" asp-controller="Account">Forgot password?</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Password visibility toggle
        document.querySelectorAll('.password-toggle').forEach(button => {
            button.addEventListener('click', (e) => {
                const input = button.previousElementSibling;
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                button.querySelector('i').classList.toggle('fa-eye-slash', isPassword);
                button.querySelector('i').classList.toggle('fa-eye', !isPassword);
            });
        });
    </script>
}
