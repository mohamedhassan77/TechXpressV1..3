@model TechXpress.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}
@section Styles {

    <style>

        body {
            background: #f5f7fa;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
        }

        .auth-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 2rem;
            position: relative;
            background: linear-gradient(135deg, #f5f7fa 0%, #e4e8ec 100%);
        }

        .auth-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06), 0 0 100px -10px rgba(0, 0, 0, 0.05);
            padding: 3rem;
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

            .auth-card h2 {
                margin-bottom: 2rem;
                font-size: 2.5rem;
                font-weight: 700;
                background: linear-gradient(120deg, #2c5282, #4299e1);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                text-align: center;
                letter-spacing: -0.5px;
            }

        form {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 0.5rem;
            position: relative;
        }

            /* Email field spans full width */
            .form-group:has(input[type="email"]) {
                grid-column: span 2;
            }

            /* Password fields side by side */
            .form-group:has(input[type="password"]) {
                grid-column: span 1;
            }

            /* Terms and button full width */
            .form-group.form-check,
            .btn-reset {
                grid-column: span 2;
            }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: #2d3748;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .form-control {
            width: 100%;
            padding: 0.875rem 1rem;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.2s ease;
            color: #2d3748;
        }

            .form-control:hover {
                background: #fff;
                border-color: #cbd5e0;
            }

            .form-control:focus {
                background: #fff;
                border-color: #4299e1;
                box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15);
                outline: none;
            }

            .form-control::placeholder {
                color: #a0aec0;
            }

        /* Date input specific styles */
        input[type="date"].form-control {
            padding: 0.75rem 1rem;
        }

        /* New Gender Field (Dropdown) */
        .form-group.gender-group {
            grid-column: span 2;
        }

        /* Validation styles */
        div[asp-validation-summary="All"] {
            display: none;
            grid-column: span 2;
        }

            div[asp-validation-summary="All"].validation-summary-errors {
                display: block;
                background: #fff5f5;
                border-left: 4px solid #fc8181;
                border-radius: 8px;
                padding: 1rem;
                color: #c53030;
                margin-bottom: 2rem;
                font-size: 0.95rem;
            }

        span[asp-validation-for] {
            display: none;
        }

            span[asp-validation-for].field-validation-error {
                display: block;
                color: #c53030;
                font-size: 0.875rem;
                margin-top: 0.5rem;
            }

        .form-check {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 0;
        }

        .form-check-input {
            width: 1.25rem;
            height: 1.25rem;
            border-radius: 6px;
            border: 2px solid #cbd5e0;
            transition: all 0.2s ease;
            cursor: pointer;
            position: relative;
        }

            .form-check-input:checked {
                background-color: #4299e1;
                border-color: #4299e1;
            }

        .form-check-label {
            font-size: 0.95rem;
            color: #4a5568;
            cursor: pointer;
        }

        .btn-reset {
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(to right, #4299e1, #2c5282);
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

            .btn-reset:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(66, 153, 225, 0.25);
            }

            .btn-reset:active {
                transform: translateY(0);
            }

        .auth-footer {
            text-align: center;
            padding-top: 1.5rem;
            margin-top: 1rem;
            border-top: 1px solid #e2e8f0;
            color: #4a5568;
            grid-column: span 2;
        }

            .auth-footer a {
                color: #4299e1;
                text-decoration: none;
                font-weight: 500;
                transition: color 0.2s ease;
            }

                .auth-footer a:hover {
                    color: #2c5282;
                    text-decoration: underline;
                }

        /* Input focus indicator */
        .form-group::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -2px;
            height: 2px;
            background: linear-gradient(to right, #4299e1, #2c5282);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .form-group:focus-within::after {
            transform: scaleX(1);
        }

        @@media (max-width: 768px) {
            .auth-container

        {
            padding: 1rem;
        }

        .auth-card {
            padding: 2rem;
            width: 95%;
        }

        form {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .form-group,
        .form-group:has(input[type="email"]),
        .form-group:has(input[type="password"]) {
            grid-column: span 1;
        }

        .auth-card h2 {
            font-size: 2rem;
        }

        }

        /* Add subtle animation for form elements */
        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .form-group {
            animation: fadeInUp 0.4s ease forwards;
            opacity: 0;
        }

            /* Stagger the animations */
            .form-group:nth-child(1) {
                animation-delay: 0.1s;
            }

            .form-group:nth-child(2) {
                animation-delay: 0.2s;
            }

            .form-group:nth-child(3) {
                animation-delay: 0.3s;
            }

            .form-group:nth-child(4) {
                animation-delay: 0.4s;
            }

            .form-group:nth-child(5) {
                animation-delay: 0.5s;
            }

            .form-group:nth-child(6) {
                animation-delay: 0.6s;
            }

            .form-group:nth-child(7) {
                animation-delay: 0.7s;
            }

    </style>
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="text-center">@ViewData["Title"]</h2>
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FirstName" class="form-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName" class="form-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <!-- New Gender Field -->
            <div class="form-group gender-group">
                <label asp-for="Gender" class="form-label">Gender</label>
                <select asp-for="Gender" class="form-control">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="form-label">Phone Number</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn-reset">Register</button>
        </form>
        <div class="auth-footer text-center mt-3">
            <p>
                Already have an account? <a asp-action="Login">Login</a>
            </p>
        </div>
    </div>
</div>
