@model ProductDetailsViewModel

@{
    ViewData["Title"] ="Details";
}

<div class="product-details">
    <div class="product-image">
        <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" class="img-fluid" />
    </div>
    <div class="product-info">
        <h2>@Model.Product.Name</h2>
        <p class="price">Price: $@Model.Product.Price</p>
        <p class="description">@Model.Product.Description</p>

        <form asp-controller="Cart" asp-action="AddToCart" method="post">
            <input type="hidden" name="productId" value="@Model.Product.Id" />
            <button class="modern-cart-btn">
                <i class="fas fa-shopping-cart"></i> Add to Cart
            </button>
            
        </form>
    </div>
    <a asp-controller="Home" asp-action="Index" class="back-to-shop">
        <i class="fas fa-shopping-bag"></i> Back to Shop
    </a>


    

</div>

@section Styles {
    <style>
    

            .back-to-shop i {
                font-size: 1.5rem;
            }

            /* Hover effect */
            .back-to-shop:hover {
                color: #ff4757;
            font-size: 1.rem;
        }

            

           

        .modern-cart-btn {
            background: linear-gradient(135deg, #4f46e5, #9333ea);
            color: white;
            font-weight: 600;
            padding: 12px 20px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

            .modern-cart-btn:hover {
                background: linear-gradient(135deg, #4338ca, #7e22ce);
                transform: scale(1.05);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
            }

        .product-details {
            display: flex;
            gap: 20px;
            margin: 40px auto;
            max-width: 800px;
        }

        .product-image img {
            width: 100%;
            max-width: 400px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .product-info {
            flex: 1;
        }

        .price {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ff5733;
        }

        .btn-primary {
            margin-top: 10px;
        }
    </style>
}
