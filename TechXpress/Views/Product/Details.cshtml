@model TechXpress.Models.UnifiedProductViewModel
@{
    ViewData["Title"] = Model.ProductDetails?.Name ?? "Product Details";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <!-- Product Image -->
        <div class="col-md-6">
            <div class="product-image">
                <img src="@Model.ProductDetails.ImageUrl" class="img-fluid" alt="@Model.ProductDetails.Name" />
            </div>
        </div>
        <!-- Product Details -->
        <div class="col-md-6">
            <h2>@Model.ProductDetails.Name</h2>
            <div class="mb-3">
                <span class="h3 text-primary">$@Model.ProductDetails.Price.ToString("N2")</span>
                @if (Model.ProductDetails.OldPrice.HasValue)
                {
                    <span class="text-muted text-decoration-line-through ms-2">
                        $@Model.ProductDetails.OldPrice.Value.ToString("N2")
                    </span>
                }
            </div>
            <div class="mb-3 d-flex align-items-center">
                <div class="ratings me-2">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="@(i <= Model.ProductDetails.AverageRating ? "bi bi-star-fill" : "bi bi-star")" style="color: #ffd700;"></i>
                    }
                </div>
                <span>(@Model.ReviewCount Reviews)</span>
            </div>
            <p>@Model.ProductDetails.Description</p>
            <div class="mb-3">
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex align-items-center">
                    <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
                    <div class="input-group me-3" style="width: 130px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decrementQuantity()">-</button>
                        <input type="number" class="form-control text-center" id="quantity" name="quantity" value="1" min="1" />
                        <button class="btn btn-outline-secondary" type="button" onclick="incrementQuantity()">+</button>
                    </div>
                    <button type="submit" class="btn btn-primary">Add to Cart</button>
                </form>
            </div>
            <div class="mb-3">
                <form asp-controller="Wishlist" asp-action="@(Model.IsInWishlist ? "Remove" : "Add")" method="post">
                    <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
                    <button type="submit" class="btn @(Model.IsInWishlist ? "btn-danger" : "btn-outline-primary")">
                        <i class="@(Model.IsInWishlist ? "bi bi-heart-fill" : "bi bi-heart")"></i>
                        @(Model.IsInWishlist ? "Remove from Wishlist" : "Add to Wishlist")
                    </button>
                </form>
            </div>
            <div class="product-meta">
                <p><strong>Category:</strong> @Model.ProductDetails.Category.Name</p>
                <p><strong>SKU:</strong> @Model.ProductDetails.SKU</p>
                <p>
                    <strong>Availability:</strong>
                    @if (Model.ProductDetails.StockQuantity > 0)
                    {
                        <span class="text-success">In Stock (@Model.ProductDetails.StockQuantity available)</span>
                    }
                    else
                    {
                        <span class="text-danger">Out of Stock</span>
                    }
                </p>
            </div>
        </div>
    </div>
    <!-- Related Products -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="row mt-5">
            <h3 class="mb-4">Related Products</h3>
            @foreach (var product in Model.RelatedProducts)
            {
                <div class="col-md-3">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
    }
    <!-- Reviews Section -->
    <div class="row mt-5">
        <h3 class="mb-4">Customer Reviews</h3>
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            foreach (var review in Model.Reviews)
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <div class="ratings me-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= review.Rating ? "bi bi-star-fill" : "bi bi-star")" style="color: #ffd700;"></i>
                            }
                        </div>
                        <span class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <p>@review.Comment</p>
                    <small class="text-muted">By @review.ApplicationUser.UserName</small>
                </div>
            }
        }
        else
        {
            <p>No reviews yet. Be the first to review this product!</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function incrementQuantity() {
            var input = document.getElementById('quantity');
            input.value = parseInt(input.value) + 1;
        }
        function decrementQuantity() {
            var input = document.getElementById('quantity');
            var value = parseInt(input.value);
            if (value > 1) {
                input.value = value - 1;
            }
        }
    </script>
}
