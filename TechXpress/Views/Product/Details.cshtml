@model TechXpress.Models.UnifiedProductViewModel

@{
    ViewData["Title"] = Model.ProductDetails?.Name ?? "Product Details";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Product Image Carousel in Details View -->
        <div class="col-lg-6">
            <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (Model.ProductDetails.ProductImages != null && Model.ProductDetails.ProductImages.Any())
                    {
                        var first = true;
                        foreach (var image in Model.ProductDetails.ProductImages)
                        {
                            <div class="carousel-item @(first ? "active" : "")">
                                <img src="@image" class="d-block w-100 product-image" alt="@Model.ProductDetails.Name">
                            </div>
                            first = false;
                        }
                    }
                    else
                    {
                        <div class="carousel-item active">
                            <img src="@Model.ProductDetails.ImageUrl" class="d-block w-100 product-image" alt="@Model.ProductDetails.Name">
                        </div>
                        <div class="carousel-item">
                            <img src="https://via.placeholder.com/500x500?text=Second+Image" class="d-block w-100 product-image" alt="Placeholder Image">
                        </div>
                        <div class="carousel-item">
                            <img src="https://via.placeholder.com/500x500?text=Third+Image" class="d-block w-100 product-image" alt="Placeholder Image">
                        </div>
                    }
                </div>
                <!-- Carousel Controls -->
                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        <!-- Product Information -->
        <div class="col-lg-6">
            <div class="card border-0">
                <div class="card-body">
                    <h2 class="card-title">@Model.ProductDetails.Name</h2>
                    <div class="mb-3">
                        <span class="h3 text-primary">@Model.ProductDetails.FinalPrice.ToString("C")</span>
                        @if (Model.ProductDetails.Price != 0)
                        {
                            <span class="text-muted text-decoration-line-through ms-2 fs-5">
                                @Model.ProductDetails.Price.ToString("C")
                            </span>
                        }
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-center">
                            <div class="ratings me-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= Model.ProductDetails.AverageRating ? "bi bi-star-fill text-warning" : "bi bi-star text-muted")"></i>
                                }
                            </div>
                            <span class="fs-6 text-muted">(@Model.ReviewCount Reviews)</span>
                        </div>
                    </div>
                    <p class="card-text">@Model.ProductDetails.Description</p>
                    <div class="mb-3">
                        <!-- Add to Cart and Buy Now Buttons -->
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex align-items-center">
                            <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
                            <div class="input-group me-3" style="max-width: 150px;">
                                <button type="button" class="btn btn-outline-secondary" onclick="decrementQuantity()">-</button>
                                <input type="number" class="form-control text-center" id="quantity" name="quantity" value="1" min="1" />
                                <button type="button" class="btn btn-outline-secondary" onclick="incrementQuantity()">+</button>
                            </div>
                            <button type="submit" class="btn btn-primary me-2">Add to Cart</button>
                            <form asp-action="Index" asp-controller="Checkout" method="post">
                                <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
                                <button type="submit" class="btn btn-success">Buy Now</button>
                            </form>
                        </form>
                    </div>
                    <div class="mb-3">
                        <form asp-controller="Wishlist" asp-action="@(Model.IsInWishlist ? "RemoveFromWishlist" : "AddToWishlist")" method="post">
                            <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
                            <button type="submit" class="btn @(Model.IsInWishlist ? "btn-danger" : "btn-outline-primary")">
                                <i class="@(Model.IsInWishlist ? "bi bi-heart-fill" : "bi bi-heart")"></i>
                                @(Model.IsInWishlist ? "Remove from Wishlist" : "Add to Wishlist")
                            </button>
                        </form>
                    </div>
                    <div class="product-meta">
                        <p><strong>Category:</strong> @Model.ProductDetails.Category.Name</p>
                        <p><strong>SKU:</strong> @Model.ProductDetails.SKU</p>
                        <p>
                            <strong>Availability:</strong>
                            @if (Model.ProductDetails.StockQuantity > 0)
                            {
                                <span class="text-success">In Stock (@Model.ProductDetails.StockQuantity available)</span>
                            }
                            else
                            {
                                <span class="text-danger">Out of Stock</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br /><br />
    <h3>Add a Review</h3>
    <form asp-action="AddReview" method="post">
        <input type="hidden" name="productId" value="@Model.ProductDetails.Id" />
        <div class="form-group">
            <label for="rating">Rating:</label>
            <div class="star-rating">
                <i class="bi bi-star" data-value="1"></i>
                <i class="bi bi-star" data-value="2"></i>
                <i class="bi bi-star" data-value="3"></i>
                <i class="bi bi-star" data-value="4"></i>
                <i class="bi bi-star" data-value="5"></i>
            </div>
            <input type="hidden" name="rating" id="rating" required />
        </div>
        <div class="form-group">
            <label for="comment">Comment:</label>
            <textarea name="comment" class="form-control" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit Review</button>
    </form>

    <!-- Display Reviews -->
    <div class="mt-5">
        <h3 class="mb-4">Customer Reviews</h3>
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="card mb-3">
                    <div class="card-body d-flex">
                        @if (review.ApplicationUser != null)
                        {
                            <img src="@review.ApplicationUser.UserProfile.ProfileImageUrl" class="rounded-circle me-3" alt="Profile Picture" width="50" height="50" />
                        }
                        else
                        {
                            <img src="~/IMG/CoP.jpg" class="rounded-circle me-3" alt="Default Profile Picture" width="50" height="50" />
                        }
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@(review.ApplicationUser?.UserProfile.ApplicationUser.FirstName ?? "Anonymous")</strong>
                                    <small class="text-muted ms-2">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <div>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= review.Rating ? "bi bi-star-fill text-warning" : "bi bi-star text-muted")"></i>
                                    }
                                </div>
                            </div>
                            <p class="card-text mt-2">@review.Comment</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No reviews yet. Be the first to review this product!</p>
        }
    </div>

    <!-- Related Products Section with Side Arrow Navigation -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="related-products mt-5">
            <h3 class="mb-4 text-center">Related Products</h3>
            <div class="related-products-wrapper position-relative">
                <button class="related-prev position-absolute start-0 top-50 translate-middle-y z-index-1 btn btn-light rounded-circle shadow-sm"><i class="bi bi-chevron-left"></i></button>
                <div class="related-products-container">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        @await Html.PartialAsync("_ProductCard", product)
                    }
                </div>
                <button class="related-next position-absolute end-0 top-50 translate-middle-y z-index-1 btn btn-light rounded-circle shadow-sm"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    }

    <!-- Lightbox Modal for Expanded Images -->
    <div id="lightbox" class="lightbox" style="display: none;" onclick="closeLightbox()">
        <div class="lightbox-content" onclick="event.stopPropagation()">
            <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close lightbox">
                &times;
            </button>
            <img id="lightbox-img" src="" alt="Expanded Image">
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script>
        // Star rating selection for reviews
        document.addEventListener("DOMContentLoaded", function () {
            const stars = document.querySelectorAll(".star-rating i");
            const ratingInput = document.getElementById("rating");

            stars.forEach(star => {
                star.addEventListener("click", function () {
                    let value = this.getAttribute("data-value");
                    ratingInput.value = value;
                    stars.forEach(s => s.classList.remove("bi-star-fill", "text-warning"));
                    for (let i = 0; i < value; i++) {
                        stars[i].classList.add("bi-star-fill", "text-warning");
                    }
                });
            });
        });

        // Quantity increment and decrement functions
        function incrementQuantity() {
            var input = document.getElementById('quantity');
            input.value = parseInt(input.value) + 1;
        }
        function decrementQuantity() {
            var input = document.getElementById('quantity');
            var value = parseInt(input.value);
            if (value > 1) {
                input.value = value - 1;
            }
        }

        // Buy Now function: redirects to Checkout with product id and quantity as query parameters
        function buyNow() {
            var productId = '@Model.ProductDetails.Id';
            var quantity = document.getElementById('quantity').value;
            window.location.href = '@Url.Action("index", "Checkout")' + '?productId=' + productId + '&quantity=' + quantity;
        }

        // Arrow navigation for related products
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.querySelector(".related-products-container");
            const prevButton = document.querySelector(".related-prev");
            const nextButton = document.querySelector(".related-next");

            // Hide previous button initially if at start
            checkScrollPosition();

            // Calculate visible width and individual item width
            const scrollAmount = () => {
                const containerWidth = container.offsetWidth;
                return containerWidth / 2; // Scroll by half the container width
            };

            prevButton.addEventListener("click", function () {
                container.scrollBy({ left: -scrollAmount(), behavior: "smooth" });
                setTimeout(checkScrollPosition, 500); // Check after animation completes
            });

            nextButton.addEventListener("click", function () {
                container.scrollBy({ left: scrollAmount(), behavior: "smooth" });
                setTimeout(checkScrollPosition, 500); // Check after animation completes
            });

            // Show/hide buttons based on scroll position
            function checkScrollPosition() {
                const isAtStart = container.scrollLeft === 0;
                const isAtEnd = container.scrollLeft + container.offsetWidth >= container.scrollWidth - 5; // 5px buffer

                prevButton.style.opacity = isAtStart ? "0.5" : "1";
                prevButton.style.pointerEvents = isAtStart ? "none" : "auto";

                nextButton.style.opacity = isAtEnd ? "0.5" : "1";
                nextButton.style.pointerEvents = isAtEnd ? "none" : "auto";
            }

            // Update button visibility on scroll
            container.addEventListener("scroll", checkScrollPosition);

            // Update on window resize
            window.addEventListener("resize", checkScrollPosition);
        });

        // Lightbox functionality
        function openLightbox(imageSrc) {
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img');
            lightboxImg.src = imageSrc;
            lightbox.style.display = 'flex';
        }
        function closeLightbox() {
            document.getElementById('lightbox').style.display = 'none';
        }
        document.addEventListener("DOMContentLoaded", function () {
            const sliderImages = document.querySelectorAll('#productCarousel .carousel-item img.product-image');
            sliderImages.forEach(img => {
                img.addEventListener('click', function () {
                    openLightbox(this.src);
                });
            });
        });
    </script>
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <style>
        /* Fixed dimensions for product detail carousel images */
        .carousel-item img.product-image {
            width: 100%;
            height: 500px;
            object-fit: scale-down;
        }

        /* Lightbox Styles with fixed image dimensions */
        .lightbox {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1100;
        }

        .lightbox-content {
            position: fixed;
            max-width: 90%;
            max-height: 90%;
        }

            .lightbox-content img {
                width: 600px; /* Fixed width */
                height: 600px; /* Fixed height */
                object-fit: scale-down;
                border-radius: 5px;
            }

        .lightbox-close {
            position: absolute;
            top: -10px;
            right: -10px;
            background: #fff;
            border: none;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }

        /* Improved Related Products Styling */
        .related-products-wrapper {
            position: relative;
            padding: 0 30px;
            margin: 0 10px;
        }

        .related-products-container {
            display: flex;
            overflow-x: auto;
            scroll-behavior: smooth;
            gap: 1.5rem;
            padding: 1rem 0;
            scroll-snap-type: x mandatory;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE/Edge */
        }

            .related-products-container::-webkit-scrollbar {
                display: none; /* Chrome, Safari, Opera */
            }

            .related-products-container .product-card {
                flex: 0 0 auto;
                width: 280px;
                scroll-snap-align: center;
                transition: transform 0.3s ease;
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                border-radius: 8px;
                overflow: hidden;
            }

                .related-products-container .product-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
                }

        .related-prev, .related-next {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 5;
        }

            .related-prev:hover, .related-next:hover {
                background-color: #f8f9fa;
                box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            }

        @@media (min-width: 768px) {
            .related-products-container {
                padding: 1rem 5px;
            }
        }
    </style>
}
