@model TechXpress.Models.ProductViewModel

<div class="modal-content">
    <div class="modal-header">
        <h5 class="modal-title">@Model.Name</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Name">
            </div>
            <div class="col-md-6">
                <h4 class="mb-3">$@Model.FinalPrice.ToString("N2")</h4>
                <p>@Model.Description</p>
                <div class="mb-3">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" data-ajax="true" data-ajax-success="onAddToCartSuccess">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="input-group mb-3" style="width: 130px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="decrementModalQuantity()">-</button>
                            <input type="number" class="form-control text-center" id="modalQuantity" name="quantity" value="1" min="1" />
                            <button class="btn btn-outline-secondary" type="button" onclick="incrementModalQuantity()">+</button>
                        </div>
                        <button type="submit" class="btn btn-primary">Add to Cart</button>
                    </form>
                </div>
                <p><strong>Category:</strong> @Model.Category.Name</p>
                <p>
                    <strong>Availability:</strong>
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="text-success">In Stock</span>
                    }
                    else
                    {
                        <span class="text-danger">Out of Stock</span>
                    }
                </p>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" class="btn btn-secondary">View Full Details</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    </div>
</div>

<script>
    function incrementModalQuantity() {
        var input = document.getElementById('modalQuantity');
        input.value = parseInt(input.value) + 1;
    }

    function decrementModalQuantity() {
        var input = document.getElementById('modalQuantity');
        var value = parseInt(input.value);
        if (value > 1) {
            input.value = value - 1;
        }
    }

    function onAddToCartSuccess(response) {
        if (response.success) {
            $('#quickViewModal').modal('hide');
            updateCartCount(response.cartItemCount);
            showToast('Item added to cart successfully');
        } else {
            showToast(response.message || 'Failed to add item to cart', 'error');
        }
    }
</script>
