@model TechXpress.Models.AdminReviewPageViewModel
@{
    ViewData["Title"] = "Review Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Review Management</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Reviews Section -->
<div class="reviews-grid row">
    @if (Model.RecentReviews.Any())
    {
        @foreach (var review in Model.RecentReviews)
        {
            <div class="col-md-4 mb-4">
                <div class="card review-card">
                    <div class="card-header text-center">
                        <strong>@(string.IsNullOrEmpty(review.UserName) ? "Unknown" : review.UserName)</strong>
                    </div>
                    <div class="card-body">
                        <p><strong>Product:</strong> @review.ProductName</p>
                        <p>
                            <strong>Rating:</strong>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= review.Rating ? "fas fa-star text-warning" : "far fa-star text-muted")"></i>
                            }
                        </p>
                        <p><strong>Comment:</strong> @review.Comment</p>
                        <p><small>Reviewed on @review.CreatedAt.ToString("MMM dd, yyyy")</small></p>
                    </div>
                    <div class="card-footer text-center">
                        <a href="@Url.Action("Details", "AdminReviews", new { id = review.Id })" class="btn btn-sm btn-primary me-1">View</a>
                        <a href="@Url.Action("Edit", "AdminReviews", new { id = review.Id })" class="btn btn-sm btn-warning me-1">Edit</a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this review?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-4">
            <i class="fas fa-comment-slash fa-3x text-muted mb-3"></i>
            <p class="text-muted">No recent reviews found.</p>
        </div>
    }
</div>

<hr />

<!-- User Management Section -->
<h2>User Management</h2>
<div class="users-grid row">
    @if (Model.UserProfiles.Any())
    {
        @foreach (var user in Model.UserProfiles)
        {
            <div class="col-md-3 mb-4">
                <div class="card user-card">
                    <div class="card-header text-center">
                        <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl) ? "/images/default-avatar.png" : user.ProfilePictureUrl)" alt="Profile Image" class="img-fluid rounded-circle" style="width: 80px; height:80px;" />
                        <div class="mt-2">
                            <span class="badge @(user.IsBlocked ? "bg-danger" : "bg-success")">
                                @(user.IsBlocked ? "Blocked" : "Active")
                            </span>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        <h5>@user.FirstName @user.LastName</h5>
                        <p>@user.Email</p>
                        <p>Joined: @user.CreatedAt.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div class="card-footer text-center">
                        <a href="@Url.Action("Details", "UserProfile", new { id = user.UserId })" class="btn btn-sm btn-primary">View</a>
                        <a href="@Url.Action("Edit", "UserProfile", new { id = user.UserId })" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeleteUser" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@user.UserId" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-4">
            <i class="fas fa-users fa-3x text-muted mb-3"></i>
            <p class="text-muted">No user profiles found.</p>
        </div>
    }
</div>

@section Styles {
    <style>
        .review-card, .user-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

            .review-card .card-header, .user-card .card-header {
                background-color: #f8f9fa;
            }
    </style>
}
