@model TechXpress.Models.ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-sm product-form-card">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Product</h3>
        </div>
        <div class="card-body">
            <h4>Are you sure you want to delete this product?</h4>
            <ul class="list-group mb-3">
                <li class="list-group-item"><strong>ID:</strong> @Model.Id</li>
                <li class="list-group-item"><strong>Name:</strong> @Model.Name</li>
                <li class="list-group-item"><strong>Price:</strong> $@Model.Price.ToString("F2")</li>
                <li class="list-group-item"><strong>Category:</strong> @Model.CategoryName</li>
                <li class="list-group-item"><strong>Description:</strong> @Model.Description</li>
            </ul>
            <form asp-action="DeleteProduct" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete Product</button>
                <a href="@Url.Action("Products", "AdminDashboard")" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .product-form-card {
        border: none;
        border-radius: 10px;
    }

        .product-form-card .card-header {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

    .list-group-item {
        background-color: #f8f9fa;
        border: none;
    }

    .btn-danger {
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .btn-secondary {
        border-radius: 5px;
    }
</style>
