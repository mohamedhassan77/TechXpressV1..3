@model TechXpress.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dashboard">
    <!-- Overview Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Users Card -->
        <div class="col-xxl-3 col-md-6">
            <div class="card stat-card users-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="ms-auto">
                            <h2>@Model.TotalUsers</h2>
                            <span>Total Users</span>
                        </div>
                    </div>
                    <div class="trend positive">
                        <i class="fas fa-arrow-up"></i> 5.2%
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Orders Card -->
        <div class="col-xxl-3 col-md-6">
            <div class="card stat-card orders-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="ms-auto">
                            <h2>@Model.TotalOrders</h2>
                            <span>Total Orders</span>
                        </div>
                    </div>
                    <div class="trend positive">
                        <i class="fas fa-arrow-up"></i> 8.1%
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Orders Card -->
        <div class="col-xxl-3 col-md-6">
            <div class="card stat-card pending-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon">
                            <i class="fas fa-hourglass-half"></i>
                        </div>
                        <div class="ms-auto">
                            <h2>@Model.PendingOrders</h2>
                            <span>Pending Orders</span>
                        </div>
                    </div>
                    <div class="trend negative">
                        <i class="fas fa-arrow-down"></i> 2.4%
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Revenue Card -->
        <div class="col-xxl-3 col-md-6">
            <div class="card stat-card revenue-card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                        <div class="ms-auto">
                            <h2>@Model.TotalRevenue.ToString("C")</h2>
                            <span>Total Revenue</span>
                        </div>
                    </div>
                    <div class="trend positive">
                        <i class="fas fa-arrow-up"></i> 12.6%
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Sections -->
    <div class="row g-4">
        <!-- Recent Products -->
        <div class="col-xl-4">
            <div class="card recent-table">
                <div class="card-header">
                    <h3><i class="fas fa-box me-2"></i>Recent Products</h3>
                    <a href="@Url.Action("Index", "AdminProducts")" class="btn btn-sm btn-light">
                        View All <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.RecentProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <tbody>
                                    @foreach (var product in Model.RecentProducts.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <div class="product-info">
                                                    <div class="icon bg-primary">
                                                        <i class="fas fa-box"></i>
                                                    </div>
                                                    <div>
                                                        <h5>@product.Name</h5>
                                                        <small>@product.CategoryName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">@product.Price.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-box-open"></i>
                            <p>No recent products</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Categories -->
        <div class="col-xl-4">
            <div class="card recent-table">
                <div class="card-header">
                    <h3><i class="fas fa-tags me-2"></i>Recent Categories</h3>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-sync-alt me-2"></i>Refresh</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-download me-2"></i>Export</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.RecentCategories.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <tbody>
                                    @foreach (var category in Model.RecentCategories.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-warning bg-opacity-10 text-warning">@category.Name</span>
                                            </td>
                                            <td class="text-end">
                                                <small class="text-muted">ID: @category.Id</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-folder-open"></i>
                            <p>No recent categories</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("Index", "AdminCategories")" class="btn btn-warning w-100">
                        <i class="fas fa-external-link-alt me-2"></i>Manage Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Reviews -->
        <div class="col-xl-4">
            <div class="card recent-table">
                <div class="card-header">
                    <h3><i class="fas fa-comments me-2"></i>Recent Reviews</h3>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-sync-alt me-2"></i>Refresh</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-download me-2"></i>Export</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.RecentReviews.Any())
                    {
                        <div class="table-responsive">
                            <table class="table">
                                <tbody>
                                    @foreach (var review in Model.RecentReviews.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <div class="user-info d-flex align-items-center">
                                                    <div class="avatar bg-info text-white rounded-circle me-2">
                                                        @review.UserName.Substring(0, 1)
                                                    </div>
                                                    <div>
                                                        <h5>@review.UserName</h5>
                                                        <small>@review.ProductName</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-end">
                                                <div class="rating-stars">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        <i class="@(i <= review.Rating ? "fas" : "far") fa-star @(i <= review.Rating ? "text-warning" : "text-muted")"></i>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-comment-slash"></i>
                            <p>No recent reviews</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-transparent">
                    <a href="@Url.Action("Index", "AdminReviews")" class="btn btn-info w-100">
                        <i class="fas fa-external-link-alt me-2"></i>Manage Reviews
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
