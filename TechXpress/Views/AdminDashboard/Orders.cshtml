@model IEnumerable<TechXpress.Models.OrderDetailsViewModel>
@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Orders</h2>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Order Date</th>
            <th>Status</th>
            <th>Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.TrackingNumber</td>
                <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                <td>@order.CurrentStatus</td>
                <td>@order.Total.ToString("C")</td>
                <td>
                    <a asp-action="OrderDetails" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
