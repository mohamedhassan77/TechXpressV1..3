@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-policy container">
    <h1>@ViewData["Title"]</h1>

    <div class="policy-content">
        <section class="mb-5">
            <h2>Introduction</h2>
            <p>At TechXpress, we are committed to protecting your privacy. This policy outlines how we collect, use, and safeguard your personal information.</p>
        </section>

        <section class="mb-5">
            <h2>Information We Collect</h2>
            <p>We may collect the following types of information:</p>
            <ul>
                <li>Personal identification information (Name, email address, phone number)</li>
                <li>Order details and purchase history</li>
                <li>Technical data (IP address, browser type, device information)</li>
            </ul>
        </section>

        <section class="mb-5">
            <h2>How We Use Your Information</h2>
            <p>Your information helps us to:</p>
            <ul>
                <li>Process and fulfill your orders</li>
                <li>Improve our products and services</li>
                <li>Communicate important updates</li>
                <li>Enhance website security</li>
            </ul>
        </section>

        <section class="mb-5">
            <h2>Data Security</h2>
            <p>We implement industry-standard security measures including:</p>
            <ul>
                <li>SSL/TLS encryption</li>
                <li>Secure payment processing</li>
                <li>Regular security audits</li>
            </ul>
        </section>

        <section class="mb-5">
            <h2>Your Rights</h2>
            <p>You have the right to:</p>
            <ul>
                <li>Access your personal data</li>
                <li>Request data correction</li>
                <li>Delete your account</li>
                <li>Opt-out of marketing communications</li>
            </ul>
        </section>

        <div class="effective-date">
            <p><strong>Effective Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>
</div>

<style>
    .privacy-policy {
        padding: 2rem 0;
        line-height: 1.6;
    }

    h1 {
        color: var(--primary);
        margin-bottom: 2rem;
    }

    h2 {
        color: var(--dark);
        margin-bottom: 1rem;
        font-size: 1.5rem;
    }

    ul {
        padding-left: 1.5rem;
    }

    li {
        margin-bottom: 0.5rem;
    }

    .effective-date {
        margin-top: 2rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
    }
</style>