@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-policy container">
    <h1>@ViewData["Title"]</h1>

    <div class="policy-content">
        <section>
            <h2>Introduction</h2>
            <p>At TechXpress, we are committed to protecting your privacy. This policy outlines how we collect, use, and safeguard your personal information.</p>
        </section>

        <section>
            <h2>Information We Collect</h2>
            <ul class="info-list">
                <li><i class="fas fa-user"></i> Personal identification (Name, Email, Phone)</li>
                <li><i class="fas fa-shopping-cart"></i> Order details & purchase history</li>
                <li><i class="fas fa-desktop"></i> Technical data (IP, browser, device)</li>
            </ul>
        </section>

        <section>
            <h2>How We Use Your Information</h2>
            <ul class="info-list">
                <li><i class="fas fa-check-circle"></i> Process & fulfill orders</li>
                <li><i class="fas fa-chart-line"></i> Improve products & services</li>
                <li><i class="fas fa-bell"></i> Send important updates</li>
                <li><i class="fas fa-shield-alt"></i> Enhance security</li>
            </ul>
        </section>

        <section>
            <h2>Data Security</h2>
            <ul class="info-list">
                <li><i class="fas fa-lock"></i> SSL/TLS encryption</li>
                <li><i class="fas fa-credit-card"></i> Secure payment processing</li>
                <li><i class="fas fa-shield-virus"></i> Regular security audits</li>
            </ul>
        </section>

        <section>
            <h2>Your Rights</h2>
            <ul class="info-list">
                <li><i class="fas fa-eye"></i> Access your personal data</li>
                <li><i class="fas fa-edit"></i> Request corrections</li>
                <li><i class="fas fa-trash"></i> Delete your account</li>
                <li><i class="fas fa-envelope-open-text"></i> Opt-out of marketing</li>
            </ul>
        </section>

        <div class="effective-date">
            <p><strong>Effective Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .privacy-policy {
            padding: 2rem 0;
            line-height: 1.7;
            max-width: 800px;
            margin: auto;
        }

        h1 {
            color: var(--primary);
            margin-bottom: 1.5rem;
            font-size: 2rem;
            text-align: center;
        }

        h2 {
            color: var(--dark);
            margin-bottom: 1rem;
            font-size: 1.4rem;
            border-left: 5px solid var(--primary);
            padding-left: 10px;
        }

        ul {
            padding-left: 0;
            list-style: none;
        }

        .info-list li {
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1rem;
        }

        .info-list i {
            color: var(--primary);
            font-size: 1.2rem;
        }

        .effective-date {
            margin-top: 2rem;
            padding-top: 1rem;
            border-top: 1px solid #ddd;
            text-align: center;
            font-weight: 500;
            color: var(--text);
        }
    </style>
}
