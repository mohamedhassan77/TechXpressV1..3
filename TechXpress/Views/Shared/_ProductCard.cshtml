@model TechXpress.Models.ProductViewModel

<div class="card product-card">
    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-primary">$@Model.Price.ToString("N2")</p>
        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" class="btn btn-sm btn-outline-primary">View Details</a>
    </div>
</div>
