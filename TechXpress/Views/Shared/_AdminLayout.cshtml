<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha384-..." crossorigin="anonymous" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="admin-layout">
        <nav class="admin-sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="Logo" class="logo" />
                <h2>Admin Panel</h2>
            </div>
            <ul class="nav-links">
                <li>
                    <a asp-controller="Admin" asp-action="Index" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-home"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Users" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Users" ? "active" : "")">
                        <i class="fas fa-users"></i> Users
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Orders" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Orders" ? "active" : "")">
                        <i class="fas fa-shopping-cart"></i> Orders
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Products" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Products" ? "active" : "")">
                        <i class="fas fa-box"></i> Products
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Categories" class="@(ViewContext.RouteData.Values["Action"].ToString() == "Categories" ? "active" : "")">
                        <i class="fas fa-tags"></i> Categories
                    </a>
                </li>
            </ul>
        </nav>
        <main class="admin-main">
            <header class="admin-header">
                <div class="header-search">
                    <input type="text" placeholder="Search..." class="form-control" />
                    <button class="btn btn-link"><i class="fas fa-search"></i></button>
                </div>
                <div class="header-actions">
                    <div class="notifications">
                        <i class="fas fa-bell"></i>
                        <span class="badge">3</span>
                    </div>
                    <div class="admin-profile">
                        <img src="~/images/admin-avatar.png" alt="Admin" />
                        <span>Admin</span>
                    </div>
                </div>
            </header>
            <div class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
