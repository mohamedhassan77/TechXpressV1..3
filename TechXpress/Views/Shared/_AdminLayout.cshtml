@using TechXpress_domain.Entities
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    // Initialize default values for current user
    ApplicationUser currentUser = null;
    string firstName = "Guest";
    string profileImageUrl = "https://www.pngarts.com/files/10/Default-Profile-Picture-Download-PNG-Image.png";
    bool isAdmin = false;

    // Load current user details if signed in
    if (SignInManager.IsSignedIn(User))
    {
        currentUser = await UserManager.Users
            .Include(u => u.UserProfile)
            .FirstOrDefaultAsync(u => u.Id == User.FindFirstValue(ClaimTypes.NameIdentifier));

        if (currentUser != null)
        {
            firstName = !string.IsNullOrEmpty(currentUser.FirstName) ? currentUser.FirstName : currentUser.UserName;
            if (currentUser.UserProfile != null && !string.IsNullOrEmpty(currentUser.UserProfile.ProfileImageUrl))
            {
                profileImageUrl = currentUser.UserProfile.ProfileImageUrl;
            }
            isAdmin = await UserManager.IsInRoleAsync(currentUser, "Admin");
        }
    }

    ViewBag.AdminFirstName = firstName;
    ViewBag.ProfileImageUrl = profileImageUrl;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TechXpress Admin</title>

    <!-- Core CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    @RenderSection("Styles", required: false)

    <style>
        :root {
            --primary: #6366f1;
            --secondary: #4f46e5;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
            --sidebar-width: 280px;
            --header-height: 72px;
        }

        body {
            background-color: #f8fafc;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        /* Modern Sidebar */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: white;
            border-right: 1px solid #e2e8f0;
            position: fixed;
            height: 100vh;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1000;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid #e2e8f0;
        }

        .logo {
            font-weight: 700;
            color: var(--primary);
            font-size: 1.5rem;
        }

        .sidebar-nav .nav-link {
            color: #64748b;
            padding: 0.75rem 1.5rem;
            margin: 0.25rem 1rem;
            border-radius: 0.75rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .sidebar-nav .nav-link:hover {
                background: #f1f5f9;
                color: var(--primary);
            }

            .sidebar-nav .nav-link.active {
                background: var(--primary);
                color: white;
                box-shadow: 0 1px 3px rgba(99, 102, 241, 0.2);
            }

        /* Main Content Area */
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Modern Header */
        .admin-header {
            height: var(--header-height);
            background: white;
            padding: 0 2rem;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .header-actions .btn {
            padding: 0.5rem;
            border-radius: 0.75rem;
            transition: all 0.2s ease;
        }

            .header-actions .btn:hover {
                background: #f1f5f9;
            }

        /* Content Container */
        .content-container {
            flex: 1;
            padding: 2rem;
            background: #f8fafc;
        }

        /* Modern Footer */
        .admin-footer {
            background: white;
            border-top: 1px solid #e2e8f0;
            padding: 1.5rem;
            margin-top: auto;
        }

        /* Responsive Design */
        @@media (max-width: 992px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-active .admin-sidebar {
                transform: translateX(0);
            }
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Modern Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-header">
                <a class="logo" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-bolt text-warning"></i> TechXpress
                </a>
            </div>
            <nav class="sidebar-nav py-3">
                <a href="@Url.Action("Index", "AdminDashboard")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminDashboard" ? "active" : "")">
                    <i class="fas fa-chart-pie"></i> Dashboard
                </a>
                <a href="@Url.Action("Index", "AdminUsers")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminUsers" ? "active" : "")">
                    <i class="fas fa-users"></i> Users
                </a>
                <a href="@Url.Action("Index", "AdminProducts")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminProducts" ? "active" : "")">
                    <i class="fas fa-cube"></i> Products
                </a>
                <a href="@Url.Action("Index", "AdminCategories")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories" ? "active" : "")">
                    <i class="fas fa-tags"></i> Categories
                </a>
                <a href="@Url.Action("Index", "AdminOrders")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOrders" ? "active" : "")">
                    <i class="fas fa-shopping-bag"></i> Orders
                </a>
                <a href="@Url.Action("Index", "AdminReviewDashboard")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminReviewDashboard" ? "active" : "")">
                    <i class="fas fa-star"></i> Reviews
                </a>
                <div class="mt-4 pt-2 border-top mx-3"></div>
                <a href="@Url.Action("Settings", "AdminDashboard")"
                   class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i> Settings
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Modern Header -->
            <header class="admin-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle btn btn-light" aria-label="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div class="input-group w-320px">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="fas fa-search text-secondary"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" placeholder="Search...">
                    </div>
                </div>

                <div class="header-actions d-flex align-items-center gap-3">
                    <button class="btn btn-light position-relative">
                        <i class="fas fa-bell"></i>
                        @if (ViewBag.UnreadNotifications > 0)
                        {
                            <span class="badge bg-danger rounded-pill position-absolute top-0 end-0">
                                @ViewBag.UnreadNotifications
                            </span>
                        }
                    </button>

                    <div class="dropdown">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <a class="d-flex align-items-center text-decoration-none"
                               href="#" id="accountDropdown" data-bs-toggle="dropdown">
                                <img src="@ViewBag.ProfileImageUrl"
                                     class="rounded-circle object-fit-cover"
                                     width="40" height="40"
                                     alt="Profile picture">
                                <div class="ms-3">
                                    <div class="text-sm font-semibold">@ViewBag.AdminFirstName</div>
                                    <div class="text-xs text-muted">Administrator</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                       asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user-circle"></i> Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                            <i class="fas fa-sign-out-alt"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </header>

            <!-- Content Area -->
            <section class="content-container">
                @RenderBody()
            </section>

            <!-- Modern Footer -->
            <footer class="admin-footer">
                <div class="container-fluid">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-sm text-muted">
                            &copy; @DateTime.Now.Year TechXpress. All rights reserved.
                        </div>
                        <div class="d-flex gap-3">
                            <a href="#" class="text-muted text-decoration-none">Privacy Policy</a>
                            <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                        </div>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    @RenderSection("Scripts", required: false)

    <!-- Core Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sidebar Toggle
            const sidebarToggle = document.querySelector('.sidebar-toggle');
            const wrapper = document.querySelector('.wrapper');

            sidebarToggle.addEventListener('click', () => {
                wrapper.classList.toggle('sidebar-active');
            });

            // Initialize DataTables
            $('.data-table').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search..."
                }
            });
        });
    </script>
</body>
</html>