<!DOCTYPE html>
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TechXpress Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css" />

    @RenderSection("Styles", required: false)

    <style>
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --success: #06d6a0;
            --warning: #ffd166;
            --danger: #ef476f;
            --dark: #212529;
            --light: #f8f9fa;
            --sidebar-width: 260px;
        }

        body {
            background-color: #f4f6f9;
            font-family: 'Inter', sans-serif;
        }

        .admin-sidebar {
            background: linear-gradient(195deg, var(--dark), #1a1e21);
            width: var(--sidebar-width);
            color: #fff;
            position: fixed;
            height: 100vh;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-nav {
            padding: 1rem;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.7);
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.2s ease;
        }

            .nav-link:hover,
            .nav-link.active {
                background: var(--primary);
                color: #fff;
            }

        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin 0.3s ease;
        }

        .admin-header {
            background: #fff;
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
        }

        .sidebar-toggle {
            border: none;
            background: transparent;
            font-size: 1.25rem;
        }

        .stat-card {
            border: none;
            border-radius: 0.75rem;
            overflow: hidden;
            transition: transform 0.2s ease;
        }

            .stat-card:hover {
                transform: translateY(-3px);
            }

        .users-card {
            background: var(--primary);
        }

        .orders-card {
            background: var(--success);
        }

        .revenue-card {
            background: var(--warning);
        }

        .pending-card {
            background: var(--danger);
        }

        .stat-card .card-body {
            color: #fff;
            position: relative;
        }

        .stat-card .icon {
            font-size: 2.5rem;
            opacity: 0.2;
        }

        .stat-card h2 {
            font-size: 2.2rem;
            margin-bottom: 0;
        }

        .recent-table {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.03);
        }

            .recent-table .card-header {
                background: #fff;
                border: none;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 1.25rem;
            }

        .table {
            border-collapse: separate;
            border-spacing: 0 0.5rem;
        }

            .table tr {
                background: #fff;
            }

                .table tr td {
                    border: none;
                    vertical-align: middle;
                    padding: 1rem;
                }

        .product-info .icon {
            width: 40px;
            height: 40px;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        @@media (max-width: 768px) {
            .admin-sidebar

        {
            margin-left: -var(--sidebar-width);
        }

        .main-content {
            margin-left: 0;
        }

        .sidebar-active .admin-sidebar {
            margin-left: 0;
        }

        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" aria-label="Admin Sidebar">
            <div class="sidebar-header">
                <h3>TechXpress</h3>
                <p>Admin Panel</p>
            </div>
            <nav class="sidebar-nav">
                <a href="@Url.Action("Index", "AdminDashboard")" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>
                <a href="@Url.Action("Users", "AdminDashboard")" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")">
                    <i class="fas fa-users"></i> Users
                </a>
                <a href="@Url.Action("Index", "AdminProducts")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminProducts" ? "active" : "")">
                    <i class="fas fa-box-open"></i> Products
                </a>
                <a href="@Url.Action("Index", "AdminCategories")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories" ? "active" : "")">
                    <i class="fas fa-tags"></i> Categories
                </a>
                <a href="@Url.Action("Orders", "AdminDashboard")" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Orders" ? "active" : "")">
                    <i class="fas fa-shopping-cart"></i> Orders
                </a>
                <a href="@Url.Action("Reviews", "AdminDashboard")" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Reviews" ? "active" : "")">
                    <i class="fas fa-comments"></i> Reviews
                </a>
                <div class="sidebar-divider"></div>
                <a href="@Url.Action("Settings", "AdminDashboard")" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="fas fa-cog"></i> Settings
                </a>
            </nav>
            <div class="sidebar-footer p-3">
                <a href="@Url.Action("Logout", "Account")" class="btn btn-danger w-100">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="admin-header">
                <button class="sidebar-toggle btn btn-light" aria-label="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="header-actions d-flex align-items-center gap-3">
                    <button class="btn btn-light position-relative" aria-label="Notifications">
                        <i class="fas fa-bell"></i>
                        @if (ViewBag.UnreadNotifications > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @ViewBag.UnreadNotifications
                            </span>
                        }
                    </button>
                    <div class="user-profile d-flex align-items-center gap-2">
                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">A</div>
                        <span class="username">Admin</span>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <section class="content-container p-4">
                @RenderBody()
            </section>

            <!-- Footer -->
            <footer class="admin-footer text-center py-3 bg-light mt-auto">
                <p class="mb-0">&copy; @DateTime.Now.Year TechXpress. All rights reserved.</p>
            </footer>
        </main>
    </div>

    @RenderSection("Scripts", required: false)

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar Toggle
            const sidebarToggle = document.querySelector('.sidebar-toggle');
            const wrapper = document.querySelector('.wrapper');
            sidebarToggle.addEventListener('click', () => {
                wrapper.classList.toggle('sidebar-active');
            });

            // Table Horizontal Scroll
            document.querySelectorAll('.table-responsive').forEach(table => {
                let isDown = false;
                let startX;
                let scrollLeft;
                table.addEventListener('mousedown', (e) => {
                    isDown = true;
                    startX = e.pageX - table.offsetLeft;
                    scrollLeft = table.scrollLeft;
                });
                table.addEventListener('mouseleave', () => { isDown = false; });
                table.addEventListener('mouseup', () => { isDown = false; });
                table.addEventListener('mousemove', (e) => {
                    if (!isDown) return;
                    e.preventDefault();
                    const x = e.pageX - table.offsetLeft;
                    const walk = (x - startX) * 2;
                    table.scrollLeft = scrollLeft - walk;
                });
            });
        });
    </script>
</body>
</html>
