@model TechXpress.Models.UnifiedProductViewModel

@{
    ViewData["Title"] = "Search";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2>Search Results</h2>

    @if (Model.Products.Any() == null || !Model.Products.Any())
    {
        <p class="text-muted">No products found matching your search.</p>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 g-4">
			@foreach (var product in Model.Products)
            {
                <div class="col">
                    <div class="card h-100">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name">
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-truncate">@product.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h5 mb-0">$@product.Price.ToString("N2")</span>
                                <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-sm btn-primary">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>