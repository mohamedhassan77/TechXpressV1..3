@model TechXpress.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    // If the model is null, create a fallback.
    var errorModel = Model ?? new TechXpress.Models.ErrorViewModel();
}

<div class="container mt-5">
    <h1 class="text-danger">An error occurred</h1>
    <p class="lead">We're sorry, but an unexpected error occurred. Please try again later.</p>
    @if (!string.IsNullOrEmpty(errorModel.RequestId))
    {
        <p>
            <strong>Request ID:</strong> <code>@errorModel.RequestId</code>
        </p>
    }
</div>
