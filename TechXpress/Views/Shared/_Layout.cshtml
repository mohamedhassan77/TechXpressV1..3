<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechXpress</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow">
            <div class="nav-container container-fluid">
                <a class="logo navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-bolt"></i> TechXpress
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="nav-menu navbar-nav">
                        <li><a href="#features" class="nav-link">Features</a></li>
                        <li><a href="#products" class="nav-link">Products</a></li>
                        <li><a href="#contact" class="nav-link">Contact</a></li>
                        <li><a asp-controller="User" asp-action="Profile" class="nav-link nav-button">My Profile</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
                @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TechXpress - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
