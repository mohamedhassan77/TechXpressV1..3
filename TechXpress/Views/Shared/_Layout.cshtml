<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TechXpress - Your premier destination for cutting-edge technology and innovative gadgets">
    <title>@ViewData["Title"] - TechXpress</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    @RenderSection("Styles", required: false)

    <style>
        /* Sticky Navbar */
        .navbar {
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 1000;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
        }

        #main-content {
            padding-top: 100px; /* Adjust based on navbar height */
        }

        /* Mobile Menu */
        .mobile-menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.8rem;
            cursor: pointer;
            color: var(--dark);
        }

        @@media (max-width: 768px) {
            .nav-menu {
                display: none;
                flex-direction: column;
                width: 100%;
                background: rgba(255, 255, 255, 0.95);
                position: absolute;
                top: 100%;
                left: 0;
                padding: 1rem 0;
                text-align: center;
                border-top: 1px solid #ccc;
            }

            .nav-menu.active {
                display: flex;
            }

            .mobile-menu-toggle {
                display: block;
            }
        }

        .footer {
            background-color: #f8f9fa;
            padding: 2rem 0;
            text-align: center;
        }

        .footer-grid {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .footer-title {
            font-weight: bold;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

        .footer-links li {
            margin: 0.5rem 0;
        }

        .social-icons a {
            margin: 0 10px;
            font-size: 1.5rem;
            color: #333;
        }

        .footer-bottom {
            margin-top: 1rem;
            font-size: 0.875rem;
            color: #666;
        }
        /* Login Styles */
        .login-container {
            max-width: 400px;
            margin: 100px auto; 
            padding: 2rem;
            border: 1px solid #ccc;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        }

        .login-title {
            text-align: center;
            margin-bottom: 1.5rem;
            font-size: 1.8rem;
            font-weight: 600;
        }

        .login-input {
            margin-bottom: 1rem;
        }

        .login-input input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 1rem;
        }

        .login-button {
            width: 100%;
            padding: 0.75rem;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 4px;
            font-size: 1.1rem;
            cursor: pointer;
        }

        .login-button:hover {
            background-color: #0056b3;
        }

        .signup-link {
            text-align: center;
            margin-top: 1rem;
        }

        .signup-link a {
            color: #007bff;
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <nav class="navbar" aria-label="Main navigation">
        <div class="nav-container">
            <a href="/" class="logo" aria-label="TechXpress Home">
                <i class="fas fa-bolt" aria-hidden="true"></i> TechXpress
            </a>

            <button class="mobile-menu-toggle" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <ul class="nav-menu">
                <li><a href="#features" class="nav-link">Features</a></li>
                <li><a href="#products" class="nav-link">Products</a></li>
                <li><a href="/Category" class="nav-link nav-button">Categories</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
                <li><a href="/UserProfile" class="nav-link nav-button">My Profile</a></li>
                <li><a href="/Account/Login" class="nav-link nav-button">Login</a></li>

                @if (User.IsInRole("Admin"))
                {
                            <li><a href="/Admin" class="nav-link nav-button">Admin Panel</a></li>
                }

                @if (User.Identity.IsAuthenticated)
                {
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link nav-button">Logout</button>
                                </form>
                            </li>
                }
            </ul>
        </div>
    </nav>

    <main id="main-content">
        @RenderBody()  
    </main>

    <footer class="footer" role="contentinfo">
        <div class="footer-grid">
            <div>
                <h2 class="footer-title">About TechXpress</h2>
                <p>Your one-stop shop for the latest and greatest in technology.</p>
            </div>

            <div>
                <h2 class="footer-title">Quick Links</h2>
                <ul class="footer-links">
                    <li><a href="#features">Features</a></li>
                    <li><a href="#products">Products</a></li>
                    <li><a href="#contact">Contact</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Connect With Us</h2>
                <div class="social-icons">
                    <a href="#" aria-label="Visit our Facebook page"><i class="fab fa-facebook"></i></a>
                    <a href="#" aria-label="Follow us on Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Check our Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Connect on LinkedIn"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2025 TechXpress. All rights reserved.</p>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.querySelector('.mobile-menu-toggle');
            const menu = document.querySelector('.nav-menu');

            if (toggle && menu) {
                toggle.addEventListener('click', function () {
                    const isExpanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !isExpanded);
                    menu.classList.toggle('active');
                });
            }

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>