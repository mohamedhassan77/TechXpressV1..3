<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TechXpress - Your premier destination for cutting-edge technology and innovative gadgets">
    <title>@ViewData["Title"] - TechXpress</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
          integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <style>
        #main-content {
            padding-top: 70px; /* Adjust this value based on your navbar height */
        }

        .navbar {
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 1000; /* Keeps navbar on top of content */
        }
    </style>
</head>
<body>
    <!-- Skip to Main Content Link -->
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Header -->
    <nav class="navbar" aria-label="Main navigation">
        <div class="nav-container">
            <a href="/" class="logo" aria-label="TechXpress Home">
                <i class="fas fa-bolt" aria-hidden="true"></i> TechXpress
            </a>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" aria-expanded="false" aria-label="Toggle navigation">
                <span class="hamburger"></span>
            </button>

            <!-- Navigation Menu -->
            <ul class="nav-menu">
                <li><a href="#features" class="nav-link">Features</a></li>
                <li><a href="#products" class="nav-link">Products</a></li>
                <li><a href="#contact" class="nav-link">Contact</a></li>
                <li><a href="/UserProfile" class="nav-link nav-button">My Profile</a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a href="/Admin" class="nav-link nav-button">Admin Panel</a></li>
                    <li><a href="/Category" class="nav-link nav-button">Categories</a></li>
                }
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer" role="contentinfo">
        <div class="footer-grid">
            <div>
                <h2 class="footer-title">About TechXpress</h2>
                <p>TechXpress is your one-stop shop for the latest and greatest in technology. We're committed to bringing innovation to your doorstep with unmatched service and expertise.</p>
            </div>

            <div>
                <h2 class="footer-title">Quick Links</h2>
                <ul class="footer-links">
                    <li><a href="#features" aria-label="View our features">Features</a></li>
                    <li><a href="#products" aria-label="Browse our products">Products</a></li>
                    <li><a href="#contact" aria-label="Contact us">Contact</a></li>
                    <li><a href="/UserProfile" aria-label="Access your profile">My Profile</a></li>
                </ul>
            </div>

            <div>
                <h2 class="footer-title">Connect With Us</h2>
                <div class="social-icons">
                    <a href="#" aria-label="Visit our Facebook page"><i class="fab fa-facebook"></i></a>
                    <a href="#" aria-label="Follow us on Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Check our Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Connect on LinkedIn"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p role="contentinfo">© 2025 TechXpress. All rights reserved.</p>
            <p>
                <a href="/privacy" aria-label="View our privacy policy">Privacy Policy</a> |
                <a href="/terms" aria-label="View our terms of service">Terms of Service</a>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    @RenderSection("Scripts", required: false)

    <!-- Mobile Menu Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.querySelector('.mobile-menu-toggle');
            const menu = document.querySelector('.nav-menu');

            if (toggle && menu) {
                toggle.addEventListener('click', function() {
                    const isExpanded = this.getAttribute('aria-expanded') === 'true';
                    this.setAttribute('aria-expanded', !isExpanded);
                    menu.classList.toggle('active');
                });
            }

            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
</body>
</html>