<!-- _QuickView.cshtml - Consolidated Dynamic Quick View Modal Partial without a strongly typed model -->
<div id="productModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-product-name" style="display:none;">
    <!-- Modal overlay -->
    <div class="modal-overlay" onclick="closeModal()"></div>
    <!-- Modal content -->
    <div class="modal-content">
        <button class="close-button" onclick="closeModal()" aria-label="Close modal">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <div class="modal-grid">
            <!-- Gallery Section using Swiper -->
            <div class="modal-gallery">
                <div class="swiper mySwiper">
                    <div class="swiper-wrapper" id="swiper-wrapper">
                        <!-- Slides will be dynamically generated -->
                    </div>
                    <!-- Swiper controls -->
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-pagination"></div>
                </div>
                <!-- Thumbnail container -->
                <div class="thumbnail-container" id="thumbnail-container">
                    <!-- Thumbnails will be dynamically generated -->
                </div>
            </div>
            <!-- Details Section -->
            <div class="modal-details">
                <!-- Product Name on its own line -->
                <div class="modal-header">
                    <h2 id="modal-product-name"></h2>
                </div>
                <!-- Rating placed under the name -->
                <div class="modal-rating" aria-label="Product rating">
                    <div class="stars" id="modal-stars">
                        <!-- Star icons generated dynamically -->
                    </div>
                    <span id="modal-review-count"></span>
                </div>
                <div class="modal-price-container">
                    <h3 id="modal-product-price"></h3>
                    <span class="stock-status" id="stock-status"><!-- Stock status if needed --></span>
                </div>
                <p id="modal-product-description"></p>
                <div class="modal-options">
                    <div class="quantity-selector">
                        <button class="quantity-btn" onclick="updateQuantity(-1)" aria-label="Decrease quantity">-</button>
                        <input type="number" id="quantity" value="1" min="1" max="99">
                        <button class="quantity-btn" onclick="updateQuantity(1)" aria-label="Increase quantity">+</button>
                    </div>
                </div>
                <div class="modal-actions">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                        <input type="hidden" id="modalProductId" name="productId" value="" />
                        <button type="submit" class="add-to-cart-button">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </button>
                    </form>
                    <form asp-controller="CheckOut" asp-action="PlaceOrder" method="post" class="d-inline">
                        <input type="hidden" id="modalProductIdOrder" name="productId" value="" />
                        <button type="submit" class="buy-now-button">
                            <i class="fas fa-bolt"></i> Buy Now
                        </button>
                    </form>
                </div>
                <div class="product-meta">
                    <div class="meta-item">
                        <i class="fas fa-shipping-fast"></i>
                        Free shipping on orders over 500 EGP
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-undo"></i>
                        30-day return policy
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-shield-alt"></i>
                        2-year warranty
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles -->
<style>
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.5);
    }

    .modal-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
    }

    .modal-content {
        position: relative;
        background: #fff;
        width: 90%;
        max-width: 1200px;
        padding: 20px;
        border-radius: 10px;
        z-index: 1060;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    }

    .close-button {
        position: absolute;
        top: 10px;
        right: 10px;
        background: transparent;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .modal-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
    }

    .modal-gallery {
        max-width: 300px;
        margin: auto;
    }

    .mySwiper {
        width: 100%;
        height: 500px;
    }

    .swiper-wrapper {
        display: flex;
    }

    .swiper-slide {
        flex-shrink: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
    }

        .swiper-slide img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            border-radius: 5px;
        }

    .thumbnail-container {
        display: flex;
        justify-content: center;
        gap: 5px;
        margin-top: 10px;
    }

    .thumbnail {
        border: 1px solid #ddd;
        padding: 3px;
        cursor: pointer;
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 3px;
    }

        .thumbnail.active {
            border-color: #007bff;
        }

    .modal-details {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .modal-header h2 {
        margin: 0;
    }

        .modal-header h2 a {
            color: inherit;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .modal-header h2 a:hover {
                color: #007bff;
            }

    .modal-rating {
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .stars {
        display: inline-block;
    }

        .stars i {
            color: #f5c518;
            margin-right: 2px;
        }

    .modal-price-container {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .stock-status {
        font-size: 0.9rem;
        color: #666;
    }

    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .quantity-btn {
        padding: 5px 10px;
        cursor: pointer;
    }

    .modal-actions {
        display: flex;
        gap: 15px;
    }

    .add-to-cart-button, .buy-now-button {
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .add-to-cart-button {
        background: #28a745;
        color: #fff;
    }

    .buy-now-button {
        background: #007bff;
        color: #fff;
    }

    .product-meta {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.9rem;
        color: #666;
    }

    @@media (max-width: 992px) {
        .modal-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- Scripts -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
      // Initialize Swiper (will be reinitialized when modal opens)
      let swiperInstance;

      function generateGallery(images) {
        const swiperWrapper = document.getElementById('swiper-wrapper');
        const thumbnailContainer = document.getElementById('thumbnail-container');
        swiperWrapper.innerHTML = "";
        thumbnailContainer.innerHTML = "";
        images.forEach((src, index) => {
          // Create slide
          const slide = document.createElement('div');
          slide.classList.add('swiper-slide');
          slide.innerHTML = `<img src="${src}" alt="Product Image ${index + 1}">`;
          swiperWrapper.appendChild(slide);
          // Create thumbnail
          const thumb = document.createElement('img');
          thumb.src = src;
          thumb.alt = `Thumbnail ${index + 1}`;
          thumb.classList.add('thumbnail');
          thumb.dataset.index = index;
          if (index === 0) thumb.classList.add('active');
          thumbnailContainer.appendChild(thumb);
        });
        // Bind thumbnail clicks
        thumbnailContainer.addEventListener('click', function (event) {
          if (event.target && event.target.classList.contains('thumbnail')) {
            const index = parseInt(event.target.dataset.index, 10);
            swiperInstance.slideToLoop(index, 300, true);
            document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
            event.target.classList.add('active');
          }
        });
      }

      // Expose function to load product data
      window.loadProductData = function (product) {
         // Update product name as a link to the details page
        document.getElementById('modal-product-name').innerHTML = `<a href="/Product/Details/${product.id}" target="_blank">${product.name}</a>`;
        document.getElementById('modal-product-price').textContent = product.price;
        document.getElementById('modal-product-description').textContent = product.description;
        generateGallery(product.images);
        // Reinitialize Swiper
        if (swiperInstance) { swiperInstance.destroy(true, true); }
        swiperInstance = new Swiper(".mySwiper", {
          loop: true,
          navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
          pagination: { el: ".swiper-pagination", clickable: true }
        });
        swiperInstance.on('slideChange', function () {
          const realIndex = swiperInstance.realIndex;
          document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
          const activeThumb = document.querySelector(`.thumbnail[data-index="${realIndex}"]`);
          if (activeThumb) activeThumb.classList.add('active');
        });
        // Reset quantity
        document.getElementById('quantity').value = 1;
        // Display the modal
        document.getElementById('productModal').style.display = 'flex';
      };
    });

    // Dummy closeModal function (implement as needed)
    function closeModal() {
      document.getElementById('productModal').style.display = 'none';
    }
</script>
