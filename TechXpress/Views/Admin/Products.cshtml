@model IEnumerable<TechXpress.Models.ProductViewModel>
@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Manage Products</h2>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>$@product.Price.ToString("F2")</td>
                    <td>@(product.CategoryName ?? "")</td>
                    <td>@product.Description</td>
                    <td>
                        <a href="@Url.Action("EditProduct", "Admin", new { id = product.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("DeleteProduct", "Admin", new { id = product.Id })" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products found.</p>
}
<a href="@Url.Action("CreateProduct", "Admin")" class="btn btn-primary mt-3">Add New Product</a>
