@{
    ViewData["Title"] = "Manage Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Manage Products</h2>
<div id="productsContainer">
    <!-- Dynamic product data will be loaded here -->
</div>
<button id="btnRefresh" class="btn btn-primary mt-3">Refresh Products</button>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            function loadProducts() {
                $.ajax({
                    url: 'https://localhost:7276/api/admin/products', // Use the correct API base URL (or relative URL if configured as proxy)
                    type: 'GET',
                    success: function (data) {
                        var html = '<table class="table table-bordered"><thead><tr><th>ID</th><th>Name</th><th>Price</th><th>Category</th><th>Actions</th></tr></thead><tbody>';
                        $.each(data, function (i, product) {
                            html += '<tr>';
                            html += '<td>' + product.id + '</td>';
                            html += '<td>' + product.name + '</td>';
                            html += '<td>' + parseFloat(product.price).toFixed(2) + '</td>';
                            html += '<td>' + (product.categoryName || '') + '</td>';
                            html += '<td>';
                            html += '<button class="btn btn-warning btn-sm" onclick="editProduct(' + product.id + ')">Edit</button> ';
                            html += '<button class="btn btn-danger btn-sm" onclick="deleteProduct(' + product.id + ')">Delete</button>';
                            html += '</td>';
                            html += '</tr>';
                        });
                        html += '</tbody></table>';
                        $('#productsContainer').html(html);
                    },
                    error: function (xhr, status, error) {
                        alert('Error loading products: ' + error);
                    }
                });
            }

            $('#btnRefresh').click(function () {
                loadProducts();
            });

            loadProducts();
        });

        function editProduct(id) {
            // Implement edit functionality (e.g., open modal with product details)
            alert('Edit product ' + id);
        }

        function deleteProduct(id) {
            if (confirm('Are you sure you want to delete product ' + id + '?')) {
                $.ajax({
                    url: 'https://localhost:7276/api/admin/products/' + id,
                    type: 'DELETE',
                    success: function () {
                        alert('Product deleted successfully.');
                        location.reload();
                    },
                    error: function (xhr, status, error) {
                        alert('Error deleting product: ' + error);
                    }
                });
            }
        }
    </script>
}
