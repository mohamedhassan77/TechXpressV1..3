@model IEnumerable<TechXpress.Models.UserProfileViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>User Management</h2>
<div class="users-grid">
    @foreach (var user in Model)
    {
        <div class="user-card">
            <div class="user-header">
                <img src="@(string.IsNullOrEmpty(user.ProfilePictureUrl) ? "/images/default-avatar.png" : user.ProfilePictureUrl)" alt="Profile Image" class="user-avatar" />
                <div class="user-status @(user.IsBlocked ? "blocked" : "active")">
                    <span>@(user.IsBlocked ? "Blocked" : "Active")</span>
                </div>
            </div>
            <div class="user-info">
                <h3>@user.FirstName @user.LastName</h3>
                <p>@user.Email</p>
                <p>Joined: @user.CreatedAt.ToString("MMM dd, yyyy")</p>
            </div>
            <div class="user-actions">
                <a href="@Url.Action("Details", "UserProfile", new { id = user.UserId })" class="btn btn-sm btn-primary">View</a>
                <a href="@Url.Action("Edit", "UserProfile", new { id = user.UserId })" class="btn btn-sm btn-warning">Edit</a>
                <form asp-action="DeleteUser" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@user.UserId" />
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
                </form>
            </div>
        </div>
    }
</div>
