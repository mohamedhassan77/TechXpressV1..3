@model TechXpress.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="dashboard-overview">
    <div class="stats">
        <div class="stat-card">
            <h3>Total Users</h3>
            <p>@Model.TotalUsers</p>
        </div>
        <div class="stat-card">
            <h3>Total Orders</h3>
            <p>@Model.TotalOrders</p>
        </div>
        <div class="stat-card">
            <h3>Pending Orders</h3>
            <p>@Model.PendingOrders</p>
        </div>
        <div class="stat-card">
            <h3>Total Revenue</h3>
            <p>$@Model.TotalRevenue.ToString("N2")</p>
        </div>
    </div>
</section>

<section class="recent-section">
    <h2>Recent Products</h2>
    @if (Model.RecentProducts.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.RecentProducts)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>$@product.Price.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No recent products found.</p>
    }
    <a href="@Url.Action("Products", "Admin")" class="btn btn-primary mt-3">Manage Products</a>
</section>

<section class="recent-section">
    <h2>Recent Categories</h2>
    @if (Model.RecentCategories.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.RecentCategories)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>@category.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No recent categories found.</p>
    }
    <a href="@Url.Action("Categories", "Admin")" class="btn btn-primary mt-3">Manage Categories</a>
</section>

<section class="recent-section">
    <h2>Recent Reviews</h2>
    @if (Model.RecentReviews != null && Model.RecentReviews.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Reviewer</th>
                    <th>Rating</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model.RecentReviews)
                {
                    <tr>
                        <td>@review.Id</td>
                        <td>@review.ProductName</td>
                        <td>@review.UserName</td>
                        <td>@review.Rating</td>
                        <td>@review.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No recent reviews found.</p>
    }
    <a href="@Url.Action("Reviews", "Admin")" class="btn btn-primary mt-3">Manage Reviews</a>
</section>
