@model TechXpress_domain.Entities.UserProfile

@{
    ViewData["Title"] = "Edit User Profile";
}

<h2>Edit User Profile</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div>
        <h4>Address Information</h4>

        @if (Model.Addresses != null && Model.Addresses.Any())
        {
            var addressList = Model.Addresses.ToList(); 

            for (int i = 0; i < addressList.Count; i++)
            {
                <input type="hidden" name="Addresses[@i].AddressId" value="@addressList[i].AddressId" />
                <input type="hidden" name="Addresses[@i].UserProfileId" value="@addressList[i].UserProfileId" />

                <div class="form-group">
                    <label>Address</label>
                    <input name="Addresses[@i].AddressLine" class="form-control" value="@addressList[i].AddressLine" />
                </div>

                <div class="form-group">
                    <label>City</label>
                    <input name="Addresses[@i].City" class="form-control" value="@addressList[i].City" />
                </div>

                <div class="form-group">
                    <label>State</label>
                    <input name="Addresses[@i].State" class="form-control" value="@addressList[i].State" />
                </div>

                <div class="form-group">
                    <label>Zip Code</label>
                    <input name="Addresses[@i].ZipCode" class="form-control" value="@addressList[i].ZipCode" />
                </div>

                <div class="form-group">
                    <label>Country</label>
                    <input name="Addresses[@i].Country" class="form-control" value="@addressList[i].Country" />
                </div>
            }
        }
        else
        {
            <p>No addresses found.</p>
        }
    </div>

    <div class="form-group">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
