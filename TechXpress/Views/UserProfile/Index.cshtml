@model IEnumerable<TechXpress_domain.Entities.UserProfile>

@{
    ViewData["Title"] = "User Profiles";
}


<nav class="navbar" aria-label="Main navigation">
    <div class="nav-container">
        <a href="/" class="logo" aria-label="TechXpress Home">
            <i class="fas fa-bolt" aria-hidden="true"></i> TechXpress
        </a>

        <button class="mobile-menu-toggle" aria-expanded="false" aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>

        <ul class="nav-menu">
            <li><a href="#features" class="nav-link">Features</a></li>
            <li><a href="#products" class="nav-link">Products</a></li>
            <li><a href="/Category" class="nav-link nav-button">Categories</a></li>
            <li><a href="#contact" class="nav-link">Contact</a></li>
            <li><a href="/UserProfile" class="nav-link nav-button">My Profile</a></li>
            <li><a href="/Account/Login" class="nav-link nav-button">Login</a></li>

            @if (User.IsInRole("Admin"))
            {
                <li><a href="/Admin" class="nav-link nav-button">Admin Panel</a></li>
            }

            @if (User.Identity.IsAuthenticated)
            {
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="nav-link nav-button">Logout</button>
                    </form>
                </li>
            }
        </ul>
    </div>
</nav>

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>User Profiles</h1>
            <p>Manage your user profiles here.</p>
        </div>
    </div>
</section>

<section class="features">
    <div class="features-grid">
        <div class="feature-card">
            <a asp-action="Create" class="nav-button">Create New</a>
            <table class="table">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FirstName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="nav-button">Edit</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="nav-button">Details</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="nav-button">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">No user profiles available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
