@model TechXpress_domain.Entities.UserProfile

@{
    ViewData["Title"] = "User Profile Details";
}

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>User Profile Details</h1>
            <p>View the details of your user profile.</p>
        </div>
    </div>
</section>

<section class="features">
    <div class="features-grid">
        <div class="feature-card">
            <dl class="row">
                <dt class="col-sm-2">Name</dt>
                <dd class="col-sm-10">@Model.FirstName</dd>
                <dd class="col-sm-10">@Model.LastName</dd>
                <dt class="col-sm-2">Email</dt>
                <dd class="col-sm-10">@Model.Email</dd>
                <dt class="col-sm-2">Phone Number</dt>
                <dd class="col-sm-10">@Model.PhoneNumber</dd>
            </dl>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="nav-button">Edit</a>
            <a asp-action="Index" class="nav-button">Back to List</a>
        </div>
    </div>
</section>